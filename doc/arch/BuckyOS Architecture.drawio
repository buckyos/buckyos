                    <mxGeometry height="30" width="111" x="450" y="1211" as="geometry"/>
                </mxCell>
                <mxCell id="fsqWt6HOSnuXdC4bvL9f-16" parent="1" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="OOD1：与 OOD3 保持隧道&lt;div&gt;直连到 OOD3、OOD2、OOD4&lt;/div&gt;&lt;div&gt;通过 rtcp 连接到 OOD5&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;OOD2：与 OOD3 保持隧道&lt;div&gt;直连到 OOD3、OOD2、OOD4&lt;/div&gt;&lt;div&gt;通过 rtcp 连接到 OOD5&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;OOD4：与 OOD3 保持隧道&lt;div&gt;直连到 OOD3、OOD2、OOD4&lt;/div&gt;&lt;div&gt;通过 rtcp 连接到 OOD5&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;OOD3：&lt;/div&gt;&lt;div&gt;通过 rtcp 连接到 OOD1、OOD2、OOD4、OOD5&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;OOD5：与 OOD3 保持隧道&lt;/div&gt;&lt;div&gt;直连到 OOD3&lt;/div&gt;&lt;div&gt;通过 rtcp 连接到 OOD1、OOD2、OOD5&lt;/div&gt;" vertex="1">
                    <mxGeometry height="290" width="221" x="638.5" y="1381" as="geometry"/>
                </mxCell>
