                <mxCell id="e6VtaDdwPvUsGqGn1qCW-17" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" value="内核" vertex="1">
