                <mxCell id="fsqWt6HOSnuXdC4bvL9f-46" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" value="node_gateway_config" vertex="1">
                    <mxGeometry height="60" width="120" x="-675" y="2369.05" as="geometry"/>
