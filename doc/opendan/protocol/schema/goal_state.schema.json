{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ActivationDecision": {
      "oneOf": [
        {
          "enum": [
            "acted",
            "created_work",
            "needs_info"
          ],
          "type": "string"
        },
        {
          "description": "Looked, nothing to do now (not \"achieved\").",
          "enum": [
            "no_action"
          ],
          "type": "string"
        },
        {
          "description": "No valid result was submitted.",
          "enum": [
            "unknown"
          ],
          "type": "string"
        }
      ]
    },
    "ActivationOutcome": {
      "enum": [
        "completed",
        "failed",
        "budget_exhausted",
        "stopped",
        "needs_input"
      ],
      "type": "string"
    },
    "ActivationReason": {
      "properties": {
        "key": {
          "description": "Input key.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ActivationReasonKind"
        },
        "missed": {
          "description": "Slots that passed while no fire was possible (`scheduled`).",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "Work sid (`child`), message key (`feedback`).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "key",
        "kind"
      ],
      "type": "object"
    },
    "ActivationReasonKind": {
      "oneOf": [
        {
          "enum": [
            "created",
            "scheduled",
            "manual",
            "reopened",
            "restarted"
          ],
          "type": "string"
        },
        {
          "description": "A Work of the Goal finished (or needs attention).",
          "enum": [
            "child"
          ],
          "type": "string"
        },
        {
          "description": "A message handed over from a UI.",
          "enum": [
            "feedback"
          ],
          "type": "string"
        },
        {
          "description": "Any other subscribed event (a followed task, an object).",
          "enum": [
            "event"
          ],
          "type": "string"
        },
        {
          "description": "A question of the Goal was answered (or closed) by the user: `ref` is its notification.",
          "enum": [
            "answer"
          ],
          "type": "string"
        }
      ]
    },
    "CandidateKind": {
      "enum": [
        "goal",
        "schedule"
      ],
      "type": "string"
    },
    "CandidateStatus": {
      "enum": [
        "proposed",
        "needs_confirmation",
        "approved",
        "materializing",
        "created",
        "linked",
        "rejected",
        "expired",
        "blocked"
      ],
      "type": "string"
    },
    "ConsolidationReceipt": {
      "description": "One batch of one Activation of the consolidation Goal (§4.1).",
      "properties": {
        "activation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "batch": {
          "description": "The complete `Batch` (replayed into the commit as it was read)."
        },
        "batch_id": {
          "type": "string"
        },
        "cleanup_pending": {
          "default": false,
          "type": "boolean"
        },
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "dispositions": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "graph_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "memory_occasion": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation_id": {
          "description": "Stable operation id = Memory idempotency key.",
          "type": "string"
        },
        "operations": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "plan": {
          "description": "The complete `ConsolidationCommit` once submitted."
        },
        "refs": {
          "default": [],
          "description": "Materials that may be disposed by this batch.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "stage": {
          "$ref": "#/definitions/ReceiptStage"
        },
        "updated_at_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "activation",
        "batch",
        "batch_id",
        "created_at_ms",
        "epoch",
        "graph_seq",
        "operation_id",
        "stage"
      ],
      "type": "object"
    },
    "GoalDistance": {
      "properties": {
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "observed_at_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "text": {
          "type": "string"
        },
        "unknowns": {
          "description": "What is not known (never \"no change\").",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "type": "object"
    },
    "GoalQuestion": {
      "properties": {
        "activation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        },
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "candidate_id": {
          "description": "The maintenance candidate this question confirms (§5.1).",
          "type": [
            "string",
            "null"
          ]
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "notify_id": {
          "description": "The notification that asks it (none: not sent, or no notification service).",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "anyOf": [
            {
              "$ref": "#/definitions/GoalQuestionStatus"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "activation",
        "at_ms",
        "epoch",
        "text"
      ],
      "type": "object"
    },
    "GoalQuestionStatus": {
      "enum": [
        "open",
        "answered",
        "dismissed",
        "expired",
        "canceled"
      ],
      "type": "string"
    },
    "GoalSkill": {
      "description": "A method / capability the Goal works with (architecture §10.2).",
      "properties": {
        "name": {
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "ref": {
          "description": "Where it is read (path, object id, behavior name).",
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "GoalUsage": {
      "description": "Usage of the current statistics period.",
      "properties": {
        "activations": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "period_start_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "tokens": {
          "default": 0,
          "description": "Tokens of the Goal Session's Activations.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "work_tokens": {
          "default": 0,
          "description": "Tokens of the Work absorbed in the period.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "works": {
          "default": 0,
          "description": "Work created in the period.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "period_start_ms"
      ],
      "type": "object"
    },
    "GoalWork": {
      "description": "A Work of the Goal not absorbed yet.",
      "properties": {
        "created_in_activation": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "goal_revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "objective": {
          "default": "",
          "type": "string"
        },
        "sid": {
          "type": "string"
        }
      },
      "required": [
        "created_in_activation",
        "epoch",
        "goal_revision",
        "sid"
      ],
      "type": "object"
    },
    "LastActivation": {
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "decision": {
          "$ref": "#/definitions/ActivationDecision"
        },
        "epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/definitions/ActivationOutcome"
        },
        "reasons": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ActivationReason"
          },
          "type": "array"
        },
        "seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "summary": {
          "default": "",
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "decision",
        "epoch",
        "outcome",
        "seq"
      ],
      "type": "object"
    },
    "MaintenanceCandidate": {
      "description": "A Goal / schedule the consolidation discovered (§5.1). P0 freezes the contract; discovery and confirmation are P1.",
      "properties": {
        "action": {
          "type": "string"
        },
        "approved_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "approved_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "approved_revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "authorization_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "candidate_id": {
          "type": "string"
        },
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "estimated_budget": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expected_effects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "intent_basis": {
          "description": "`explicit | inferred`.",
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/CandidateKind"
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "linked_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing_fields": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "notify_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "operation_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "proposed": true,
        "question_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "retry_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "review_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "scope": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "semantic_key": {
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/CandidateStatus"
        },
        "title": {
          "type": "string"
        },
        "updated_at_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "action",
        "candidate_id",
        "created_at_ms",
        "intent_basis",
        "kind",
        "revision",
        "semantic_key",
        "status",
        "title"
      ],
      "type": "object"
    },
    "MaintenanceState": {
      "description": "`GoalState.maintenance` of the consolidation Goal.",
      "properties": {
        "abandoned_batches": {
          "default": 0,
          "description": "Batches read but never committed (recovery dropped them; the material stays for the next batch).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "candidates": {
          "items": {
            "$ref": "#/definitions/MaintenanceCandidate"
          },
          "type": "array"
        },
        "consolidations": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "dispositions": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "last_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_successful_consolidation_at_ms": {
          "description": "Last commit that really changed or disposed something.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "operations": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "receipts": {
          "items": {
            "$ref": "#/definitions/ConsolidationReceipt"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "succeeded",
        "failed",
        "stopped"
      ],
      "type": "string"
    },
    "ReceiptStage": {
      "description": "Stage of a consolidation receipt (§4.1): each step is re-entrant, a crash resumes from the stage it reached.",
      "oneOf": [
        {
          "description": "The batch was read (and, with `plan`, the plan persisted).",
          "enum": [
            "prepared"
          ],
          "type": "string"
        },
        {
          "description": "The Memory envelope is committed under `operation_id`.",
          "enum": [
            "memory_committed"
          ],
          "type": "string"
        },
        {
          "description": "Candidates are published to the Goal State.",
          "enum": [
            "published"
          ],
          "type": "string"
        },
        {
          "description": "Cleanup of the disposed bodies ran (retried on its own when it failed: `cleanup_pending`).",
          "enum": [
            "completed"
          ],
          "type": "string"
        },
        {
          "description": "The commit was refused for good (a stale lease); needs attention.",
          "enum": [
            "failed"
          ],
          "type": "string"
        }
      ]
    },
    "RecentWork": {
      "properties": {
        "absorbed_in": {
          "description": "`(epoch, activation)` that absorbed it.",
          "items": [
            {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            },
            {
              "format": "uint64",
              "minimum": 0.0,
              "type": "integer"
            }
          ],
          "maxItems": 2,
          "minItems": 2,
          "type": "array"
        },
        "one_line_status": {
          "default": "",
          "type": "string"
        },
        "outcome": {
          "anyOf": [
            {
              "$ref": "#/definitions/Outcome"
            },
            {
              "type": "null"
            }
          ]
        },
        "report_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "sid": {
          "type": "string"
        }
      },
      "required": [
        "absorbed_in",
        "sid"
      ],
      "type": "object"
    }
  },
  "description": "`state.json`.",
  "properties": {
    "absorbed": {
      "description": "Work whose end was taken in by an Activation (any epoch; bounded).",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "active_works": {
      "items": {
        "$ref": "#/definitions/GoalWork"
      },
      "type": "array"
    },
    "current_skills": {
      "items": {
        "$ref": "#/definitions/GoalSkill"
      },
      "type": "array"
    },
    "distance": {
      "anyOf": [
        {
          "$ref": "#/definitions/GoalDistance"
        },
        {
          "type": "null"
        }
      ]
    },
    "epoch": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "goal_id": {
      "type": "string"
    },
    "goal_revision_seen": {
      "default": 0,
      "description": "Goal revision the last Activation worked with.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "last_activation": {
      "anyOf": [
        {
          "$ref": "#/definitions/LastActivation"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_error": true,
    "maintenance": {
      "anyOf": [
        {
          "$ref": "#/definitions/MaintenanceState"
        },
        {
          "type": "null"
        }
      ],
      "description": "The consolidation Goal's typed maintenance state (receipts, candidates, consolidation summary); committed with the session."
    },
    "pending": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "questions": {
      "description": "Questions for the user: sent as notifications when the host has a notification service; answers come back as `answer` Activations.",
      "items": {
        "$ref": "#/definitions/GoalQuestion"
      },
      "type": "array"
    },
    "recent_works": {
      "items": {
        "$ref": "#/definitions/RecentWork"
      },
      "type": "array"
    },
    "rev": {
      "description": "Monotonic; every published change.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "schema": {
      "type": "string"
    },
    "updated_at_ms": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "usage": {
      "allOf": [
        {
          "$ref": "#/definitions/GoalUsage"
        }
      ],
      "default": {
        "activations": 0,
        "period_start_ms": 0,
        "tokens": 0,
        "work_tokens": 0,
        "works": 0
      }
    }
  },
  "required": [
    "epoch",
    "goal_id",
    "rev",
    "schema"
  ],
  "title": "GoalState",
  "type": "object"
}