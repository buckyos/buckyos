{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "WorkspaceAccess": {
      "enum": [
        "read_only",
        "read_write"
      ],
      "type": "string"
    },
    "WorkspaceRef": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "allOf": [
            {
              "$ref": "#/definitions/WorkspaceAccess"
            }
          ],
          "default": "read_write"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "workspace_id"
      ],
      "type": "object"
    }
  },
  "description": "`state/artifacts/<aid>/artifact.json`.",
  "properties": {
    "aid": {
      "type": "string"
    },
    "head": {
      "default": null,
      "description": "Version the user accepted last (`null` = none valid).",
      "type": [
        "string",
        "null"
      ]
    },
    "rev": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "updated_at_ms": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkspaceRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "aid"
  ],
  "title": "ArtifactHead",
  "type": "object"
}