{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "WorkspaceAccess": {
      "enum": [
        "read_only",
        "read_write"
      ],
      "type": "string"
    },
    "WorkspaceBinding": {
      "properties": {
        "access": {
          "$ref": "#/definitions/WorkspaceAccess"
        },
        "location": {
          "$ref": "#/definitions/WorkspaceLocation"
        },
        "location_revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "revision": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "runtime_host": {
          "type": "string"
        },
        "workspace_id": {
          "type": "string"
        }
      },
      "required": [
        "access",
        "location",
        "location_revision",
        "revision",
        "runtime_host",
        "workspace_id"
      ],
      "type": "object"
    },
    "WorkspaceLocation": {
      "properties": {
        "directory": {
          "type": "string"
        },
        "runtime_id": {
          "type": "string"
        }
      },
      "required": [
        "directory",
        "runtime_id"
      ],
      "type": "object"
    }
  },
  "description": "`binding.json` — written once on the first drive (§7.1).",
  "properties": {
    "bound_at_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "bound_by": {
      "type": "string"
    },
    "kind": {
      "description": "`native | tmux`.",
      "type": "string"
    },
    "runtime_id": {
      "type": "string"
    },
    "schema": {
      "type": "string"
    },
    "target": true,
    "workdir": {
      "description": "Absolute workdir for exec (the only place absolute paths are allowed besides `runs/`).",
      "type": "string"
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkspaceBinding"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "bound_at_ms",
    "bound_by",
    "kind",
    "runtime_id",
    "schema",
    "target",
    "workdir"
  ],
  "title": "Binding",
  "type": "object"
}