      "type": "object"
    },
    "SessionPolicy": {
      "description": "`session.policy`: the session template resolved at creation (xAgent §4.7) and frozen with the session.",
      "properties": {
        "load_hints": {
          "default": true,
          "type": "boolean"
        },
        "max_process_depth": {
          "default": 4,
          "description": "Callers on `process_stack` at most (sub contexts in progress).",
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_session_depth": {
          "default": 2,
          "description": "Nesting depth of sub sessions below this session's root.",
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
        "max_sub_sessions": {
          "default": 4,
          "description": "Sub sessions not finished at the same time.",
          "format": "uint8",
          "minimum": 0.0,
          "type": "integer"
        },
