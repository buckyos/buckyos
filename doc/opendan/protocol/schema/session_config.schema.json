{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Acl": {
      "properties": {
        "agent_access": {
          "allOf": [
            {
              "$ref": "#/definitions/AgentAccess"
            }
          ],
          "default": "full"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "readers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AgentAccess": {
      "enum": [
        "full",
        "status_only"
      ],
      "type": "string"
    },
    "AgentEvent": {
      "description": "`type = \"event\"` payload: something this session cares about happened. The poster only describes the event; whether it is an Input or an Observe is decided by the receiving session's subscriptions.",
      "properties": {
        "data_ref": {
          "description": "ObjId or a path relative to the session directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "description": "`changed | updated | finished | fired ...`.",
          "type": "string"
        },
        "seq": {
          "description": "Version inside the source; Observe merging compares it.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/definitions/EventSource"
        },
        "subscription_id": {
          "description": "Explicit subscription id; may be empty for implicit subscriptions.",
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "description": "One sentence for the LLM (≤ 1 KB); never parsed mechanically.",
          "type": "string"
        },
        "terminal": {
          "description": "The source's final event.",
          "type": "boolean"
        }
      },
      "required": [
        "event",
        "source",
        "summary"
      ],
      "type": "object"
    },
    "BehaviorBudget": {
      "additionalProperties": false,
      "properties": {
        "max_completion_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_consecutive_errors": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_tool_iterations": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_total_tokens": {
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "max_wallclock_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "BehaviorCapabilities": {
      "additionalProperties": false,
      "properties": {
        "action_whitelist": {
          "description": "Named tools offered as actions (behavior loop).",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tool_whitelist": {
          "description": "Tools offered as native functions (`None`: the session's tools). An entry is a tool name or `group:<builtin group>`.",
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "BehaviorConfig": {
      "additionalProperties": false,
      "description": "One behavior of the agent, includes expanded.",
      "properties": {
        "budget": {
          "allOf": [
            {
              "$ref": "#/definitions/BehaviorBudget"
            }
          ],
          "default": {}
        },
        "capabilities": {
          "allOf": [
            {
              "$ref": "#/definitions/BehaviorCapabilities"
            }
          ],
          "default": {}
        },
        "entry": {
          "allOf": [
            {
              "$ref": "#/definitions/BehaviorEntryConfig"
            }
          ],
          "default": {}
        },
        "hooks": {
          "additionalProperties": true,
          "description": "Host hooks (`on_context_limit_reached` …): carried, not interpreted.",
          "type": "object"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/definitions/InputSection"
            },
            {
              "type": "null"
            }
          ]
        },
        "meta": {
          "allOf": [
            {
              "$ref": "#/definitions/BehaviorMeta"
            }
          ],
          "default": {
            "name": ""
          }
        },
        "model": {
          "allOf": [
            {
              "$ref": "#/definitions/BehaviorModel"
            }
          ],
          "default": {}
        },
        "prompt": {
          "allOf": [
            {
              "$ref": "#/definitions/BehaviorPromptConfig"
            }
          ],
          "default": {}
        }
      },
      "type": "object"
    },
    "BehaviorEntryConfig": {
      "additionalProperties": false,
      "description": "How the behavior is entered (decided by the target, §3.3). `mode` may only be left out by a session's entry behavior (`switch_context`).",
      "properties": {
        "inherit": {
          "anyOf": [
            {
              "$ref": "#/definitions/InheritMode"
            },
            {
              "type": "null"
            }
          ]
        },
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/ContextMode"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "BehaviorLoop": {
      "description": "Loop of the behavior's own context.",
      "enum": [
        "function_call",
        "behavior"
      ],
      "type": "string"
    },
    "BehaviorMeta": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "default": "",
          "type": "string"
        },
        "next": {
          "description": "Behaviors this one may hand over to or call: the frozen closure.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "objective": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "BehaviorModel": {
      "additionalProperties": false,
      "properties": {
        "fallbacks": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "preferred": {
          "type": [
            "string",
            "null"
          ]
        },
        "temperature": {
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "BehaviorPromptConfig": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "anyOf": [
            {
              "$ref": "#/definitions/BehaviorLoop"
            },
            {
              "type": "null"
            }
          ],
          "description": "`None`: the session's `prompt.llm_context.loop_model`."
        },
        "on_context_switch": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_init": {
          "type": [
            "string",
            "null"
          ]
        },
        "on_input": {
          "type": [
            "string",
            "null"
          ]
        },
        "semi_subscription_snapshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "system": {
          "description": "System template of the behavior's context.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Channels": {
      "properties": {
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/definitions/InputSourceConfig"
          },
          "type": "array"
        },
        "outbound": {
          "anyOf": [
            {
              "$ref": "#/definitions/OutboundBinding"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the session's replies go, fixed when it is created: a reply whose route differs is not sent."
        },
        "wake_event": {
          "description": "kevent id published after posting; every segment only uses letters, digits and `_ - .`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ContextMode": {
      "description": "How a behavior is entered when a hand-over (`next_behavior`) or a `call_behavior` tool call names it. Decided by the target behavior, never by the session as a whole; there is no default mode.",
      "oneOf": [
        {
          "description": "The target has its own context (system, tools, history, run): created on first entry, resumed from its own snapshot afterwards.",
          "enum": [
            "switch_context"
          ],
          "type": "string"
        },
        {
          "description": "A new sub context per call with the target's system and task input, plus an explicit selection of the caller's history; its result returns to the caller.",
          "enum": [
            "create_sub_context"
          ],
          "type": "string"
        },
        {
          "description": "A new branch per call that keeps the caller's system and its complete effective history at the fork point; its result returns to the caller.",
          "enum": [
            "fork"
          ],
          "type": "string"
        }
      ]
    },
    "ControlCommand": {
      "description": "`type = \"control\"` payload: session control, executed by the runner. Never enters the LLM context and produces no input receipt.",
      "oneOf": [
        {
          "properties": {
            "command": {
              "enum": [
                "stop"
              ],
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "description": "The only input a finished session still accepts.",
          "properties": {
            "by": {
              "default": "",
              "type": "string"
            },
            "command": {
              "enum": [
                "decide"
              ],
              "type": "string"
            },
            "decision": {
              "description": "`accept | discard`.",
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "command",
            "decision"
          ],
          "type": "object"
        },
        {
          "properties": {
            "command": {
              "enum": [
                "subscribe"
              ],
              "type": "string"
            },
            "subscription": {
              "$ref": "#/definitions/Subscription"
            }
          },
          "required": [
            "command",
            "subscription"
          ],
          "type": "object"
        },
        {
          "properties": {
            "command": {
              "enum": [
                "unsubscribe"
              ],
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Activity declaration (e.g. `agent-session activity --touch <ref>`).",
          "properties": {
            "clear": {
              "default": false,
              "type": "boolean"
            },
            "command": {
              "enum": [
                "activity"
              ],
              "type": "string"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "touch": {
              "items": {
                "$ref": "#/definitions/Touching"
              },
              "type": "array"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "description": "A perception record of this session (the former `perception` input).",
          "properties": {
            "command": {
              "enum": [
                "perceive"
              ],
              "type": "string"
            },
            "kind": {
              "default": "observation",
              "type": "string"
            },
            "objects": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "summary": {
              "default": "",
              "type": "string"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "CreatedBy": {
      "properties": {
        "principal": {
          "description": "`app:<appid>@<owner>` (A9).",
          "type": "string"
        },
        "via": {
          "default": "app",
          "description": "`app | ui_session:<sid> | opendan | task_mgr:<task_id>`.",
          "type": "string"
        }
      },
      "required": [
        "principal"
      ],
      "type": "object"
    },
    "DriverRef": {
      "properties": {
        "principal": {
          "description": "Driving identity = the appid of the driving process (Q9 / Q16).",
          "type": "string"
        }
      },
      "required": [
        "principal"
      ],
      "type": "object"
    },
    "EndCondition": {
      "properties": {
        "detail": true,
        "type": {
          "$ref": "#/definitions/EndConditionType"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "EndConditionType": {
      "oneOf": [
        {
          "enum": [
            "llm_declares_done",
            "output_schema"
          ],
          "type": "string"
        },
        {
          "description": "Finish after `detail.n` (default 1) completed logical Turns; between them the session waits for input. Internal hand-overs (context switch, sub context call / return) are not Turns and cost nothing.",
          "enum": [
            "max_turns"
          ],
          "type": "string"
        }
      ]
    },
    "EventSource": {
      "description": "Where an event comes from.",
      "properties": {
        "id": {
          "default": "",
          "description": "object: object id; session: sid; task: task_id; timer: timer name; system: may be empty.",
          "type": "string"
        },
        "kind": {
          "description": "`object | session | task | timer | system`; unknown kinds are not a format error (an event without a matching subscription is dropped).",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "FrozenPrompt": {
      "description": "`prompt.frozen`: what the session took from the behavior catalog when it was constructed. Later catalog changes never reach the session; a behavior used for the first time afterwards is added once (`control_applied{behavior_frozen}` in the worklog).",
      "properties": {
        "behaviors": {
          "additionalProperties": {
            "$ref": "#/definitions/BehaviorConfig"
          },
          "type": "object"
        },
        "catalog_rev": {
          "default": "",
          "description": "Catalog revision at the first freeze (audit).",
          "type": "string"
        },
        "frozen_at_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "frozen_by": {
          "default": "",
          "type": "string"
        },
        "identity": {
          "allOf": [
            {
              "$ref": "#/definitions/IdentityText"
            }
          ],
          "default": {}
        }
      },
      "type": "object"
    },
    "IdentityText": {
      "description": "Identity text of the agent (`role.md`, `self.md`, `i18n/`).",
      "properties": {
        "i18n": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "role": {
          "type": "string"
        },
        "self": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "InheritMode": {
      "description": "History a new context starts with (besides its system and task input).",
      "oneOf": [
        {
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "description": "The session history rendered by the host (summary + recent worklog records): a filtered view, labelled `<session_history>`.",
          "enum": [
            "recent_dialogue"
          ],
          "type": "string"
        },
        {
          "description": "The caller's completed steps as structured records (`create_sub_context`, both contexts in the behavior loop).",
          "enum": [
            "steps"
          ],
          "type": "string"
        }
      ]
    },
    "InputMedia": {
      "description": "Whether attachments also enter the context as image / document blocks.",
      "oneOf": [
        {
          "description": "Text references only (`<attachment .../>` lines); the agent reads attachments with tools.",
          "enum": [
            "reference"
          ],
          "type": "string"
        },
        {
          "description": "Image / document attachments additionally as content blocks (at most [`MAX_INLINE_MEDIA`] per batch).",
          "enum": [
            "inline"
          ],
          "type": "string"
        }
      ]
    },
    "InputMode": {
      "description": "How many selected inputs one `on_input` batch takes.",
      "oneOf": [
        {
          "description": "One msg / Input event per batch; the rest stays queued.",
          "enum": [
            "single"
          ],
          "type": "string"
        },
        {
          "description": "As many as the batch budget allows.",
          "enum": [
            "batch"
          ],
          "type": "string"
        }
      ]
    },
    "InputPolicy": {
      "enum": [
        "any",
        "supplement_only",
        "none"
      ],
      "type": "string"
    },
    "InputSection": {
      "additionalProperties": false,
      "description": "Input consumption policy of a context (separate from its templates).",
      "properties": {
        "media": {
          "allOf": [
            {
              "$ref": "#/definitions/InputMedia"
            }
          ],
          "default": "reference"
        },
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/InputMode"
            }
          ],
          "default": "batch"
        }
      },
      "type": "object"
    },
    "InputSourceConfig": {
      "oneOf": [
        {
          "description": "kmsg queue input (all sessions).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "kmsg"
              ],
              "type": "string"
            },
            "queue": {
              "type": "string"
            },
            "subscriber": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "queue",
            "subscriber"
          ],
          "type": "object"
        }
      ]
    },
    "MechanicalCompress": {
      "description": "Mechanical compression parameters for rendering worklog history (§4.4).",
      "properties": {
        "drop_kinds": {
          "default": [
            "created",
            "decide",
            "compaction",
            "input_rejected",
            "event_dropped",
            "turn_ended"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_result_chars": {
          "default": 4096,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "recent_full_responses": {
          "default": 2,
          "description": "Model responses rendered in full, counted from the newest: the unit is one recorded response, i.e. a behavior `step` or a function call `assistant_message` (with the entries after it). Older entries are cut to `summary_chars`.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "summary_chars": {
          "default": 280,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "MsgDelivery": {
      "description": "Delivery layer information; everything optional.",
      "properties": {
        "conversation_name": {
          "description": "Display name of the conversation (group name).",
          "type": [
            "string",
            "null"
          ]
        },
        "from_name": {
          "description": "Display name of the speaker.",
          "type": [
            "string",
            "null"
          ]
        },
        "record_id": {
          "description": "msg-center record id (audit).",
          "type": [
            "string",
            "null"
          ]
        },
        "tunnel": {
          "description": "DID of the ingress tunnel.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ObserveScope": {
      "description": "Material of the semi-subscription snapshot and the fresh view.",
      "enum": [
        "off",
        "events",
        "events_and_active"
      ],
      "type": "string"
    },
    "Origin": {
      "properties": {
        "created_by_call": {
          "description": "`<run_id>/<call_id>` of the tool call that created the session.",
          "type": [
            "string",
            "null"
          ]
        },
        "intent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_session": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_messages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReportMode"
            },
            {
              "type": "null"
            }
          ],
          "description": "How the parent session hears about this session (chosen by the parent when it created it). `None`: no implicit reporting."
        }
      },
      "type": "object"
    },
    "OutboundBinding": {
      "description": "Reply coordinates of a session bound to one conversation.",
      "properties": {
        "kind": {
          "description": "MsgObject kind of the replies.",
          "type": "string"
        },
        "to": {
          "description": "The peer (one-to-one) or the group.",
          "type": "string"
        },
        "to_session": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "to"
      ],
      "type": "object"
    },
    "PostedInput": {
      "description": "Producer side: one logical record to post.",
      "oneOf": [
        {
          "properties": {
            "payload": {
              "$ref": "#/definitions/SessionMsg"
            },
            "type": {
              "enum": [
                "msg"
              ],
              "type": "string"
            }
          },
          "required": [
            "payload",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "payload": {
              "$ref": "#/definitions/AgentEvent"
            },
            "type": {
              "enum": [
                "event"
              ],
              "type": "string"
            }
          },
          "required": [
            "payload",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "payload": {
              "$ref": "#/definitions/ControlCommand"
            },
            "type": {
              "enum": [
                "control"
              ],
              "type": "string"
            }
          },
          "required": [
            "payload",
            "type"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "at_ms": {
          "description": "Posting time; display / diagnosis only, never ordering.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "from": {
          "description": "Poster principal (self-reported, audit only): neither the speaker nor a source of permissions.",
          "type": "string"
        },
        "key": {
          "description": "Dedup key of the logical input: a re-post keeps it, another input uses another one. `msg`: the message's ObjId.",
          "type": "string"
        },
        "schema": {
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "from",
        "key",
        "schema"
      ],
      "type": "object"
    },
    "PromptSection": {
      "description": "Prompt configuration: a superset of xllm's `.llm_context` (§4.2).",
      "properties": {
        "behavior": {
          "description": "Entry behavior of the session (`behaviors/<name>` of the agent).",
          "type": [
            "string",
            "null"
          ]
        },
        "compact_ratio": {
          "description": "Compact after a run once the history uses more than this ratio of the budget (`maybe_compact`).",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "context": {
          "description": "Initial context material supplied by the application.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "frozen": {
          "anyOf": [
            {
              "$ref": "#/definitions/FrozenPrompt"
            },
            {
              "type": "null"
            }
          ],
          "description": "Behaviors and identity frozen from the agent's catalog."
        },
        "history_budget_tokens": {
          "description": "Context budget (tokens) available to the history section when the next llm_context is assembled. `None` → runner default.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "initial_inputs": {
          "description": "Bootstrap inputs of a session created without an input queue: `msg` records only, at most [`super::input::MAX_PENDING_INPUTS`], never changed after creation. The runner reads them as the read-only source [`BOOTSTRAP_SRC`] (index from 1).",
          "items": {
            "$ref": "#/definitions/PostedInput"
          },
          "type": "array"
        },
        "input": {
          "allOf": [
            {
              "$ref": "#/definitions/InputSection"
            }
          ],
          "description": "Input consumption of the session's base context."
        },
        "llm_context": {
          "description": "JSON form of an xllm `.llm_context` file (same schema, strict keys). xllm can resume a run of this session without understanding the OpenDAN extensions below."
        },
        "mechanical_compress": {
          "allOf": [
            {
              "$ref": "#/definitions/MechanicalCompress"
            }
          ],
          "default": {
            "drop_kinds": [
              "created",
              "decide",
              "compaction",
              "input_rejected",
              "event_dropped",
              "turn_ended"
            ],
            "max_result_chars": 4096,
            "recent_full_responses": 2,
            "summary_chars": 280
          }
        },
        "on_context_switch": {
          "description": "Hand-over into the target context (switch, sub context, its return).",
          "type": [
            "string",
            "null"
          ]
        },
        "on_init": {
          "description": "Session bootstrap message.",
          "type": [
            "string",
            "null"
          ]
        },
        "on_input": {
          "description": "Selected external msg / Input events.",
          "type": [
            "string",
            "null"
          ]
        },
        "semi_subscription_snapshot": {
          "description": "The snapshot message placed before a controlled input.",
          "type": [
            "string",
            "null"
          ]
        },
        "system": {
          "description": "Application system prompt (S-05); composed after the agent identity and the non-overridable constraints.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "ReportMode": {
      "description": "What a parent receives from a sub session without subscribing: the registry state stays the truth, these events only accelerate.",
      "oneOf": [
        {
          "description": "Needs attention (waiting for input / a decision) and the end: Input.",
          "enum": [
            "final"
          ],
          "type": "string"
        },
        {
          "description": "`final` plus progress, kept as semi-subscription state.",
          "enum": [
            "progress"
          ],
          "type": "string"
        },
        {
          "description": "Nothing is pushed; the parent reads the registry itself.",
          "enum": [
            "none"
          ],
          "type": "string"
        }
      ]
    },
