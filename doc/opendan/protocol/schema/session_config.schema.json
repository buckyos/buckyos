        "route_key": {
          "description": "UI sessions only (deferred, V1).",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/definitions/Scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "type": "string"
        },
        "task_binding": true,
        "timezone": {
          "description": "User time zone bound to the session (IANA name). Never the runner machine's zone: protocol times are UTC, and this value is shown to the agent through the default semi subscription ([`USER_TIMEZONE_SUBSCRIPTION`]).",
          "type": [
            "string",
            "null"
          ]
        }
