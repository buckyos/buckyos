          },
          "required": [
            "task_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A timer (`source = timer:<name>`).",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "timer"
              ],
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A system source (`source = system:<id>`).",
          "properties": {
            "id": {
              "default": "",
              "type": "string"
            },
            "type": {
              "enum": [
                "system"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
