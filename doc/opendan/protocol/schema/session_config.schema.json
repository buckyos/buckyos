        "created_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "created_by": {
          "$ref": "#/definitions/CreatedBy"
        },
        "driver": {
          "$ref": "#/definitions/DriverRef"
        },
        "end_condition": {
          "allOf": [
