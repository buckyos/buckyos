{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Acl": {
      "properties": {
        "agent_access": {
          "allOf": [
            {
              "$ref": "#/definitions/AgentAccess"
            }
          ],
          "default": "full"
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        },
        "readers": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "AgentAccess": {
      "enum": [
        "full",
        "status_only"
      ],
      "type": "string"
    },
    "Channels": {
      "properties": {
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/definitions/InputSourceConfig"
          },
          "type": "array"
        },
        "outbound": true,
        "wake_event": {
          "description": "kevent id published after posting; every segment only uses letters, digits and `_ - .`.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CreatedBy": {
      "properties": {
        "principal": {
          "description": "`app:<appid>@<owner>` (A9).",
          "type": "string"
        },
        "via": {
          "default": "app",
          "description": "`app | ui_session:<sid> | opendan | task_mgr:<task_id>`.",
          "type": "string"
        }
      },
      "required": [
        "principal"
      ],
      "type": "object"
    },
    "DriverRef": {
      "properties": {
        "principal": {
          "description": "Driving identity = the appid of the driving process (Q9 / Q16).",
          "type": "string"
        }
      },
      "required": [
        "principal"
      ],
      "type": "object"
    },
    "EndCondition": {
      "properties": {
        "detail": true,
        "type": {
          "$ref": "#/definitions/EndConditionType"
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "EndConditionType": {
      "oneOf": [
        {
          "enum": [
            "llm_declares_done",
            "output_schema"
          ],
          "type": "string"
        },
        {
          "description": "Finish after `detail.n` (default 1) completed logical Turns; between them the session waits for input. Internal hand-overs (context switch, sub context call / return) are not Turns and cost nothing.",
          "enum": [
            "max_turns"
          ],
          "type": "string"
        }
      ]
    },
    "InputMedia": {
      "description": "Whether attachments also enter the context as image / document blocks.",
      "oneOf": [
        {
          "description": "Text references only (`<attachment .../>` lines); the agent reads attachments with tools.",
          "enum": [
            "reference"
          ],
          "type": "string"
        },
        {
          "description": "Image / document attachments additionally as content blocks (at most [`MAX_INLINE_MEDIA`] per batch).",
          "enum": [
            "inline"
          ],
          "type": "string"
        }
      ]
    },
    "InputMode": {
      "description": "How many selected inputs one `on_input` batch takes.",
      "oneOf": [
        {
          "description": "One msg / Input event per batch; the rest stays queued.",
          "enum": [
            "single"
          ],
          "type": "string"
        },
        {
          "description": "As many as the batch budget allows.",
          "enum": [
            "batch"
          ],
          "type": "string"
        }
      ]
    },
    "InputPolicy": {
      "enum": [
        "any",
        "supplement_only",
        "none"
      ],
      "type": "string"
    },
    "InputSection": {
      "additionalProperties": false,
      "description": "Input consumption policy of a context (separate from its templates).",
      "properties": {
        "media": {
          "allOf": [
            {
              "$ref": "#/definitions/InputMedia"
            }
          ],
          "default": "reference"
        },
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/InputMode"
            }
          ],
          "default": "batch"
        }
      },
      "type": "object"
    },
    "InputSourceConfig": {
      "oneOf": [
        {
          "description": "kmsg queue input (all sessions).",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "kmsg"
              ],
              "type": "string"
            },
            "queue": {
              "type": "string"
            },
            "subscriber": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind",
            "queue",
            "subscriber"
          ],
          "type": "object"
        }
      ]
    },
    "MechanicalCompress": {
      "description": "Mechanical compression parameters for rendering worklog history (§4.4).",
      "properties": {
        "drop_kinds": {
          "default": [
            "created",
            "decide",
            "compaction",
            "input_rejected",
            "event_dropped",
            "turn_ended"
          ],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "max_result_chars": {
          "default": 4096,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "recent_full_responses": {
          "default": 2,
          "description": "Model responses rendered in full, counted from the newest: the unit is one recorded response, i.e. a behavior `step` or a function call `assistant_message` (with the entries after it). Older entries are cut to `summary_chars`.",
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "summary_chars": {
          "default": 280,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "Origin": {
      "properties": {
        "intent_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "parent_session": {
          "type": [
            "string",
            "null"
          ]
        },
        "reason_messages": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "PromptSection": {
      "description": "Prompt configuration: a superset of xllm's `.llm_context` (§4.2).",
      "properties": {
        "behavior": {
          "description": "`behaviors/<name>` reference (BehaviorAssembler).",
          "type": [
            "string",
            "null"
          ]
        },
        "compact_ratio": {
          "description": "Compact after a run once the history uses more than this ratio of the budget (`maybe_compact`).",
          "format": "float",
          "type": [
            "number",
            "null"
          ]
        },
        "context": {
          "description": "Initial context material supplied by the application.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "history_budget_tokens": {
          "description": "Context budget (tokens) available to the history section when the next llm_context is assembled. `None` → runner default.",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "input": {
          "allOf": [
            {
              "$ref": "#/definitions/InputSection"
            }
          ],
          "description": "Input consumption of the session's base context."
        },
        "llm_context": {
          "description": "JSON form of an xllm `.llm_context` file (same schema, strict keys). xllm can resume a run of this session without understanding the OpenDAN extensions below."
        },
        "mechanical_compress": {
          "allOf": [
            {
              "$ref": "#/definitions/MechanicalCompress"
            }
          ],
          "default": {
            "drop_kinds": [
              "created",
              "decide",
              "compaction",
              "input_rejected",
              "event_dropped",
              "turn_ended"
            ],
            "max_result_chars": 4096,
            "recent_full_responses": 2,
            "summary_chars": 280
          }
        },
        "on_context_switch": {
          "description": "Hand-over into the target context (switch, sub context, its return).",
          "type": [
            "string",
            "null"
          ]
        },
        "on_init": {
          "description": "Session bootstrap message.",
          "type": [
            "string",
            "null"
          ]
        },
        "on_input": {
          "description": "Selected external msg / Input events.",
          "type": [
            "string",
            "null"
          ]
        },
        "semi_subscription_snapshot": {
          "description": "The snapshot message placed before a controlled input.",
          "type": [
            "string",
            "null"
          ]
        },
        "system": {
          "description": "Application system prompt (S-05); composed after the agent identity and the non-overridable constraints.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "RuntimeRequirement": {
      "properties": {
        "app_tools": {
          "description": "Tools that only exist inside the runner process; verified on every drive (§7.1).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "runtime_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "tools": {
          "description": "Executables that must be reachable on PATH.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RuntimeSection": {
      "properties": {
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "type": "object"
        },
        "requirement": {
          "allOf": [
            {
              "$ref": "#/definitions/RuntimeRequirement"
            }
          ],
          "default": {}
        },
        "tool_plan": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "Scope": {
      "description": "Initial activity declaration: what this session plans to modify (§6.7).",
      "properties": {
        "objects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "paths": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "SessionKind": {
      "enum": [
        "ui",
        "work",
        "self_improve",
        "self_check"
      ],
      "type": "string"
    },
    "SessionSection": {
      "properties": {
        "acl": {
          "allOf": [
            {
              "$ref": "#/definitions/Acl"
            }
          ],
          "default": {
            "agent_access": "full"
          }
        },
        "agent_did": {
          "type": "string"
        },
        "class": {
          "default": "work",
          "description": "`agent.toml [session.<class>]`; decides loop / driver defaults.",
          "type": "string"
        },
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "created_by": {
          "$ref": "#/definitions/CreatedBy"
        },
        "driver": {
          "$ref": "#/definitions/DriverRef"
        },
        "end_condition": {
          "allOf": [
            {
              "$ref": "#/definitions/EndCondition"
            }
          ],
          "default": {
            "type": "llm_declares_done"
          }
        },
        "idempotency_key": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_policy": {
          "allOf": [
            {
              "$ref": "#/definitions/InputPolicy"
            }
          ],
          "default": "any"
        },
        "kind": {
          "$ref": "#/definitions/SessionKind"
        },
        "objective": {
          "default": "",
          "type": "string"
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/definitions/Origin"
            },
            {
              "type": "null"
            }
          ]
        },
        "route_key": {
          "description": "UI sessions only (deferred, V1).",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "anyOf": [
            {
              "$ref": "#/definitions/Scope"
            },
            {
              "type": "null"
            }
          ]
        },
        "session_id": {
          "type": "string"
        },
        "task_binding": true,
        "timezone": {
          "description": "User time zone bound to the session (IANA name). Never the runner machine's zone: protocol times are UTC, and this value is shown to the agent through the default semi subscription ([`USER_TIMEZONE_SUBSCRIPTION`]).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "agent_did",
        "created_at_ms",
        "created_by",
        "driver",
        "kind",
        "session_id"
      ],
      "type": "object"
    },
    "Subscription": {
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/SubscriptionMode"
        },
        "source": {
          "$ref": "#/definitions/SubscriptionSource"
        },
        "watch": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "mode",
        "source"
      ],
      "type": "object"
    },
    "SubscriptionMode": {
      "oneOf": [
        {
          "description": "A matching event is an Input: it wakes the session and enters a controlled input batch.",
          "enum": [
            "active"
          ],
          "type": "string"
        },
        {
          "description": "A matching event is an Observe: merged into `pending_events` and shown as the semi-subscription snapshot before the next controlled input; never triggers inference by itself.",
          "enum": [
            "semi"
          ],
          "type": "string"
        }
      ]
    },
    "SubscriptionSource": {
      "oneOf": [
        {
          "description": "Another session of the same agent (pull: registry rev compare; always observed). Also matches bus events with `source = session:<ref>`.",
          "properties": {
            "ref": {
              "type": "string"
            },
            "type": {
              "enum": [
                "session"
              ],
              "type": "string"
            }
          },
          "required": [
            "ref",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Object events bridged into the bus (`source = object:<object>`). `event` empty or `*` matches every event name.",
          "properties": {
            "event": {
              "default": "",
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "type": {
              "enum": [
                "object_event"
              ],
              "type": "string"
            }
          },
          "required": [
            "object",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A task (`source = task:<task_id>`).",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "task"
              ],
              "type": "string"
            }
          },
          "required": [
            "task_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A timer (`source = timer:<name>`).",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "timer"
              ],
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A system source (`source = system:<id>`).",
          "properties": {
            "id": {
              "default": "",
              "type": "string"
            },
            "type": {
              "enum": [
                "system"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "WorkspaceRef": {
      "oneOf": [
        {
          "description": "Agent internal workspace `<agent_root>/workspace/<id>`.",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "agent"
              ],
              "type": "string"
            }
          },
          "required": [
            "id",
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "Directory owned by a user / application.",
          "properties": {
            "kind": {
              "enum": [
                "external"
              ],
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        }
      ]
    }
  },
  "properties": {
    "artifact_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "channels": {
      "allOf": [
        {
          "$ref": "#/definitions/Channels"
        }
      ],
      "default": {
        "inputs": []
      }
    },
    "config_rev": {
      "default": 1,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "extensions": {
      "additionalProperties": true,
      "description": "Application extension items, preserved verbatim.",
      "type": "object"
    },
    "prompt": {
      "allOf": [
        {
          "$ref": "#/definitions/PromptSection"
        }
      ],
      "default": {
        "mechanical_compress": {
          "drop_kinds": [
            "created",
            "decide",
            "compaction",
            "input_rejected",
            "event_dropped",
            "turn_ended"
          ],
          "max_result_chars": 4096,
          "recent_full_responses": 2,
          "summary_chars": 280
        }
      }
    },
    "runtime": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeSection"
        }
      ],
      "default": {
        "requirement": {}
      }
    },
    "schema": {
      "type": "string"
    },
    "session": {
      "$ref": "#/definitions/SessionSection"
    },
    "subscriptions": {
      "items": {
        "$ref": "#/definitions/Subscription"
      },
      "type": "array"
    },
    "workspace": {
      "anyOf": [
        {
          "$ref": "#/definitions/WorkspaceRef"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema",
    "session"
  ],
  "title": "SessionConfig",
  "type": "object"
}