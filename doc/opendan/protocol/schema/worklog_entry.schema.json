{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "ActionEntry": {
      "properties": {
        "args": {
          "default": null
        },
        "call_id": {
          "type": "string"
        },
        "effect": {
          "default": "unknown",
          "description": "`read_only | idempotent | side_effect | unknown`.",
          "type": "string"
        },
        "tool": {
          "type": "string"
        }
      },
      "required": [
        "call_id",
        "tool"
      ],
      "type": "object"
    },
    "InputRef": {
      "description": "Stable reference to one consumed input instance.",
      "properties": {
        "index": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "description": "`msg | event | control`.",
          "type": "string"
        },
        "src": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "src"
      ],
      "type": "object"
    },
    "ReportArtifact": {
      "properties": {
        "digest": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "reference": {
          "type": "string"
        }
      },
      "required": [
        "digest",
        "path",
        "reference"
      ],
      "type": "object"
    },
    "ReportSource": {
      "oneOf": [
        {
          "properties": {
            "call_id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "tool"
              ],
              "type": "string"
            }
          },
          "required": [
            "call_id",
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "enum": [
                "behavior"
              ],
              "type": "string"
            },
            "step_index": {
              "format": "uint32",
              "minimum": 0.0,
              "type": "integer"
            }
          },
          "required": [
            "kind",
            "step_index"
          ],
          "type": "object"
        }
      ]
    },
    "ReportSubmission": {
      "properties": {
        "accepted_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "artifacts": {
          "default": [],
          "items": {
            "$ref": "#/definitions/ReportArtifact"
          },
          "type": "array"
        },
        "id": {
          "type": "string"
        },
        "is_end": {
          "type": "boolean"
        },
        "report": {
          "type": "string"
        },
        "result": true,
        "run_id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/definitions/ReportSource"
        }
      },
      "required": [
        "accepted_at_ms",
        "id",
        "is_end",
        "report",
        "run_id",
        "source"
      ],
      "type": "object"
    },
    "TurnStatus": {
      "description": "How a logical Turn ended (decided by the session from the outcome and the hand-over state, never by the waist alone).",
      "oneOf": [
        {
          "description": "A result was delivered (final answer, a reply before waiting for input, or the session finished).",
          "enum": [
            "completed"
          ],
          "type": "string"
        },
        {
          "description": "A non-recoverable error ended the run.",
          "enum": [
            "failed"
          ],
          "type": "string"
        },
        {
          "description": "The run's budget was exhausted.",
          "enum": [
            "budget_exhausted"
          ],
          "type": "string"
        },
        {
          "description": "`control(stop)`.",
          "enum": [
            "stopped"
          ],
          "type": "string"
        }
      ]
    }
  },
  "description": "Worklog entry bodies (format of `opendan.session_state/6` sessions).\n\nIdentities: an input batch is `(run_id, input_seq)`, a Turn is `turn` (session-wide), a behavior Step is `(run_id, step_index)`, a tool call / action is its `call_id`. Entries of one run carry the Turn they belong to.",
  "oneOf": [
    {
      "properties": {
        "assistant": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "submission": {
          "$ref": "#/definitions/ReportSubmission"
        },
        "t": {
          "enum": [
            "report_delivery"
          ],
          "type": "string"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "assistant",
        "run_id",
        "submission",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "description": "First entry of every session.",
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "by": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "objective": {
          "default": "",
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "t": {
          "enum": [
            "created"
          ],
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "by",
        "kind",
        "session_id",
        "t"
      ],
      "type": "object"
    },
    {
      "description": "The input batch that opened a logical Turn.",
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "events": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hook": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/definitions/InputRef"
          },
          "type": "array"
        },
        "run_id": {
          "type": "string"
        },
        "t": {
          "enum": [
            "turn_started"
          ],
          "type": "string"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "at_ms",
        "input_seq",
        "run_id",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "description": "An input batch that joined the open Turn (hand-over, sub context return, input consumed while the Turn was in progress).",
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "events": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hook": {
          "type": [
            "string",
            "null"
          ]
        },
        "input_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "inputs": {
          "default": [],
          "items": {
            "$ref": "#/definitions/InputRef"
          },
          "type": "array"
        },
        "run_id": {
          "type": "string"
        },
        "t": {
          "enum": [
            "input_batch"
          ],
          "type": "string"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "at_ms",
        "input_seq",
        "run_id",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "properties": {
        "content": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "t": {
          "enum": [
            "user_message"
          ],
          "type": "string"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "content",
        "run_id",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "description": "Function call runs: one assistant response (one Round), with the native tool calls it requested. Not a behavior Step.",
      "properties": {
        "assistant": {
          "default": "",
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "t": {
          "enum": [
            "assistant_message"
          ],
          "type": "string"
        },
        "tool_calls": {
          "items": {
            "$ref": "#/definitions/ActionEntry"
          },
          "type": "array"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "description": "Behavior runs: one `StepRecord` (decision + actions; results follow as `action_result`).",
      "properties": {
        "actions": {
          "items": {
            "$ref": "#/definitions/ActionEntry"
          },
          "type": "array"
        },
        "assistant": {
          "default": "",
          "type": "string"
        },
        "behavior": {
          "type": [
            "string",
            "null"
          ]
        },
        "correction": {
          "description": "A synthetic step recording a rejected response (parse failure / policy rejection) fed back for self-correction, not a decision.",
          "type": "boolean"
        },
        "run_id": {
          "type": "string"
        },
        "step_index": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "t": {
          "enum": [
            "step"
          ],
          "type": "string"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "run_id",
        "step_index",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "description": "Result of a native tool call or a behavior action (`call_id`).",
      "properties": {
        "call_id": {
          "type": "string"
        },
        "result": {
          "default": "",
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "status": {
          "description": "`ok | error | unresolved | cancelled | pending`.",
          "type": "string"
        },
        "t": {
          "enum": [
            "action_result"
          ],
          "type": "string"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "call_id",
        "run_id",
        "status",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "description": "How the session ended or set aside a run (written with the run's history). Outcomes that keep the run open (pending tool, context limit pause, interrupt, retryable error) write nothing here.",
      "properties": {
        "kind": {
          "description": "Run ended: `done | wait | process_done | budget | error | stopped`; process suspended into `process_stack`: `suspended`; `context_rewritten`: the run hit the context limit, its history so far is above this entry and it continues from the compacted session history. Not a Turn end: see `turn_ended`.",
          "type": "string"
        },
        "next_behavior": {
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "t": {
          "enum": [
            "outcome"
          ],
          "type": "string"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "run_id",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "description": "The session closed a logical Turn.",
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "run_id": {
          "default": "",
          "type": "string"
        },
        "status": {
          "$ref": "#/definitions/TurnStatus"
        },
        "t": {
          "enum": [
            "turn_ended"
          ],
          "type": "string"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "at_ms",
        "status",
        "t",
        "turn"
      ],
      "type": "object"
    },
    {
      "description": "A new summary.json was produced (audit only).",
      "properties": {
        "made_by": {
          "default": "",
          "type": "string"
        },
        "summary_start_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "t": {
          "enum": [
            "compaction"
          ],
          "type": "string"
        }
      },
      "required": [
        "summary_start_seq",
        "t"
      ],
      "type": "object"
    },
    {
      "properties": {
        "by": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "report": true,
        "t": {
          "enum": [
            "decide"
          ],
          "type": "string"
        }
      },
      "required": [
        "by",
        "decision",
        "t"
      ],
      "type": "object"
    },
    {
      "description": "An input marked consumed without being processed. `reason` is a `RejectReason` name.",
      "properties": {
        "detail": {
          "type": "string"
        },
        "input": {
          "$ref": "#/definitions/InputRef"
        },
        "reason": {
          "type": "string"
        },
        "t": {
          "enum": [
            "input_rejected"
          ],
          "type": "string"
        }
      },
      "required": [
        "input",
        "reason",
        "t"
      ],
      "type": "object"
    },
    {
      "description": "An event consumed without entering the context or `pending_events`: no valid subscription matched (`unsubscribed`), or it only woke the wait of a suspended call (`pending_call`).",
      "properties": {
        "input": {
          "$ref": "#/definitions/InputRef"
        },
        "reason": {
          "type": "string"
        },
        "t": {
          "enum": [
            "event_dropped"
          ],
          "type": "string"
        }
      },
      "required": [
        "input",
        "reason",
        "t"
      ],
      "type": "object"
    },
    {
      "description": "Control inputs applied outside a run (stop / subscribe / activity).",
      "properties": {
        "command": {
          "type": "string"
        },
        "detail": true,
        "input": {
          "$ref": "#/definitions/InputRef"
        },
        "t": {
          "enum": [
            "control_applied"
          ],
          "type": "string"
        }
      },
      "required": [
        "command",
        "input",
        "t"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "seq": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "seq"
  ],
  "title": "WorklogEntry",
  "type": "object"
}