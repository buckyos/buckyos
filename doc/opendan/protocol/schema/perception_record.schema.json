{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "One line of `state/perception/<sid>.jsonl`.",
  "properties": {
    "at_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "kind": {
      "description": "`round_digest | observation | task_outcome | task_discarded`.",
      "type": "string"
    },
    "objects": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "payload": true,
    "refs": true,
    "seq": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "session_id": {
      "type": "string"
    },
    "source": {
      "default": "session",
      "description": "`session | self`.",
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "at_ms",
    "kind",
    "seq",
    "session_id"
  ],
  "title": "PerceptionRecord",
  "type": "object"
}