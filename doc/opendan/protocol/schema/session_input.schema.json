{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "AgentEvent": {
      "description": "`type = \"event\"` payload: something this session cares about happened. The poster only describes the event; whether it is an Input or an Observe is decided by the receiving session's subscriptions.",
      "properties": {
        "data_ref": {
          "description": "ObjId or a path relative to the session directory.",
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "description": "`changed | updated | finished | fired ...`.",
          "type": "string"
        },
        "seq": {
          "description": "Version inside the source; Observe merging compares it.",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "source": {
          "$ref": "#/definitions/EventSource"
        },
        "subscription_id": {
          "description": "Explicit subscription id; may be empty for implicit subscriptions.",
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "description": "One sentence for the LLM (≤ 1 KB); never parsed mechanically.",
          "type": "string"
        },
        "terminal": {
          "description": "The source's final event.",
          "type": "boolean"
        }
      },
      "required": [
        "event",
        "source",
        "summary"
      ],
      "type": "object"
    },
    "ControlCommand": {
      "description": "`type = \"control\"` payload: session control, executed by the runner. Never enters the LLM context and produces no input receipt.",
      "oneOf": [
        {
          "properties": {
            "command": {
              "enum": [
                "stop"
              ],
              "type": "string"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "description": "The only input a finished session still accepts.",
          "properties": {
            "by": {
              "default": "",
              "type": "string"
            },
            "command": {
              "enum": [
                "decide"
              ],
              "type": "string"
            },
            "decision": {
              "description": "`accept | discard`.",
              "type": "string"
            },
            "note": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "command",
            "decision"
          ],
          "type": "object"
        },
        {
          "properties": {
            "command": {
              "enum": [
                "subscribe"
              ],
              "type": "string"
            },
            "subscription": {
              "$ref": "#/definitions/Subscription"
            }
          },
          "required": [
            "command",
            "subscription"
          ],
          "type": "object"
        },
        {
          "properties": {
            "command": {
              "enum": [
                "unsubscribe"
              ],
              "type": "string"
            },
            "id": {
              "type": "string"
            }
          },
          "required": [
            "command",
            "id"
          ],
          "type": "object"
        },
        {
          "description": "Activity declaration (e.g. `agent-session activity --touch <ref>`).",
          "properties": {
            "clear": {
              "default": false,
              "type": "boolean"
            },
            "command": {
              "enum": [
                "activity"
              ],
              "type": "string"
            },
            "summary": {
              "type": [
                "string",
                "null"
              ]
            },
            "touch": {
              "items": {
                "$ref": "#/definitions/Touching"
              },
              "type": "array"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
        {
          "description": "A perception record of this session (the former `perception` input).",
          "properties": {
            "command": {
              "enum": [
                "perceive"
              ],
              "type": "string"
            },
            "kind": {
              "default": "observation",
              "type": "string"
            },
            "objects": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "summary": {
              "default": "",
              "type": "string"
            },
            "tags": {
              "items": {
                "type": "string"
              },
              "type": "array"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      ]
    },
    "EventSource": {
      "description": "Where an event comes from.",
      "properties": {
        "id": {
          "default": "",
          "description": "object: object id; session: sid; task: task_id; timer: timer name; system: may be empty.",
          "type": "string"
        },
        "kind": {
          "description": "`object | session | task | timer | system`; unknown kinds are not a format error (an event without a matching subscription is dropped).",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "MsgDelivery": {
      "description": "Delivery layer information; everything optional.",
      "properties": {
        "conversation_name": {
          "description": "Display name of the conversation (group name).",
          "type": [
            "string",
            "null"
          ]
        },
        "from_name": {
          "description": "Display name of the speaker.",
          "type": [
            "string",
            "null"
          ]
        },
        "record_id": {
          "description": "msg-center record id (audit).",
          "type": [
            "string",
            "null"
          ]
        },
        "tunnel": {
          "description": "DID of the ingress tunnel.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "SessionMsg": {
      "description": "`type = \"msg\"` payload: the message object as it is plus what a MsgObject does not carry by design.",
      "properties": {
        "delivery": {
          "$ref": "#/definitions/MsgDelivery"
        },
        "msg": {
          "description": "cyfs-ndn MsgObject v2, never rewritten or trimmed."
        }
      },
      "required": [
        "msg"
      ],
      "type": "object"
    },
    "Subscription": {
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/SubscriptionMode"
        },
        "source": {
          "$ref": "#/definitions/SubscriptionSource"
        },
        "watch": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "mode",
        "source"
      ],
      "type": "object"
    },
    "SubscriptionMode": {
      "oneOf": [
        {
          "description": "A matching event is an Input: it wakes the session and enters a controlled input batch.",
          "enum": [
            "active"
          ],
          "type": "string"
        },
        {
          "description": "A matching event is an Observe: merged into `pending_events` and shown as the semi-subscription snapshot before the next controlled input; never triggers inference by itself.",
          "enum": [
            "semi"
          ],
          "type": "string"
        }
      ]
    },
    "SubscriptionSource": {
      "oneOf": [
        {
          "description": "Another session of the same agent (pull: registry rev compare; always observed). Also matches bus events with `source = session:<ref>`.",
          "properties": {
            "ref": {
              "type": "string"
            },
            "type": {
              "enum": [
                "session"
              ],
              "type": "string"
            }
          },
          "required": [
            "ref",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Object events bridged into the bus (`source = object:<object>`). `event` empty or `*` matches every event name.",
          "properties": {
            "event": {
              "default": "",
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "type": {
              "enum": [
                "object_event"
              ],
              "type": "string"
            }
          },
          "required": [
            "object",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A task (`source = task:<task_id>`).",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "task"
              ],
              "type": "string"
            }
          },
          "required": [
            "task_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A timer (`source = timer:<name>`).",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "timer"
              ],
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A system source (`source = system:<id>`).",
          "properties": {
            "id": {
              "default": "",
              "type": "string"
            },
            "type": {
              "enum": [
                "system"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Touching": {
      "properties": {
        "kind": {
          "description": "`path | object | artifact`.",
          "type": "string"
        },
        "mode": {
          "default": "write",
          "description": "`read | write`.",
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "since_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "type": "object"
    }
  },
  "description": "Producer side: one logical record to post.",
  "oneOf": [
    {
      "properties": {
        "payload": {
          "$ref": "#/definitions/SessionMsg"
        },
        "type": {
          "enum": [
            "msg"
          ],
          "type": "string"
        }
      },
      "required": [
        "payload",
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "payload": {
          "$ref": "#/definitions/AgentEvent"
        },
        "type": {
          "enum": [
            "event"
          ],
          "type": "string"
        }
      },
      "required": [
        "payload",
        "type"
      ],
      "type": "object"
    },
    {
      "properties": {
        "payload": {
          "$ref": "#/definitions/ControlCommand"
        },
        "type": {
          "enum": [
            "control"
          ],
          "type": "string"
        }
      },
      "required": [
        "payload",
        "type"
      ],
      "type": "object"
    }
  ],
  "properties": {
    "at_ms": {
      "description": "Posting time; display / diagnosis only, never ordering.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "from": {
      "description": "Poster principal (self-reported, audit only): neither the speaker nor a source of permissions.",
      "type": "string"
    },
    "key": {
      "description": "Dedup key of the logical input: a re-post keeps it, another input uses another one. `msg`: the message's ObjId.",
      "type": "string"
    },
    "schema": {
      "type": "string"
    }
  },
  "required": [
    "at_ms",
    "from",
    "key",
    "schema"
  ],
  "title": "PostedInput",
  "type": "object"
}