{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BaselineCheck": {
      "description": "The last check of a runtime's tools ([`crate::baseline`]) against what it declares: only a hint, the declaration decides (Q5).",
      "properties": {
        "checked_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "error": {
          "description": "Why the check could not run (the runtime was not reachable).",
          "type": [
            "string",
            "null"
          ]
        },
        "ext": {
          "anyOf": [
            {
              "$ref": "#/definitions/ExtCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "level": {
          "allOf": [
            {
              "$ref": "#/definitions/RuntimeBaseline"
            }
          ],
          "default": "standard",
          "description": "The declaration checked against."
        },
        "missing": {
          "default": [],
          "description": "Commands of that level not found on the runtime's PATH.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        },
        "resolved": {
          "additionalProperties": {
            "$ref": "#/definitions/ResolvedCommand"
          },
          "default": {},
          "description": "Where each command found is, standard and extended.",
          "type": "object"
        },
        "unmanaged": {
          "default": [],
          "description": "Standard commands found outside `$BUCKYOS_ROOT`: not the standard ones.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "checked_at_ms",
        "ok"
      ],
      "type": "object"
    },
    "ComputerAccess": {
      "description": "ComputerUse capability of an Agent on a runtime: `none` grants no Computer operation, `observe` grants inspect/observe, `control` adds act.",
      "enum": [
        "none",
        "observe",
        "control"
      ],
      "type": "string"
    },
    "ExecutorOp": {
      "oneOf": [
        {
          "enum": [
            "open_stream",
            "describe",
            "exec",
            "read",
            "write",
            "edit",
            "computer_inspect",
            "computer_observe",
            "computer_act",
            "query",
            "cancel"
          ],
          "type": "string"
        },
        {
          "description": "Create a directory (and missing parents inside the roots).",
          "enum": [
            "mkdir"
          ],
          "type": "string"
        },
        {
          "description": "Whether a path is a file, a directory or missing.",
          "enum": [
            "stat"
          ],
          "type": "string"
        },
        {
          "description": "Move a regular file inside the roots (atomic commit of a transfer).",
          "enum": [
            "rename"
          ],
          "type": "string"
        },
        {
          "description": "Delete a regular file inside the roots.",
          "enum": [
            "remove"
          ],
          "type": "string"
        }
      ]
    },
    "ExtCheck": {
      "description": "The extended layer of a runtime, whatever it declares.",
      "properties": {
        "missing": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/ExtStatus"
        },
        "system": {
          "default": [],
          "description": "Extended commands that are there but not from an extension package.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "ExtStatus": {
      "oneOf": [
        {
          "description": "Every extended tool, all from extension packages.",
          "enum": [
            "ok"
          ],
          "type": "string"
        },
        {
          "description": "Some extended tools are missing.",
          "enum": [
            "partial"
          ],
          "type": "string"
        },
        {
          "description": "None of them is there.",
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "description": "Every extended tool, some from the machine or the Agent.",
          "enum": [
            "system"
          ],
          "type": "string"
        }
      ]
    },
    "NativeComputerConfig": {
      "additionalProperties": false,
      "properties": {
        "access": {
          "$ref": "#/definitions/ComputerAccess"
        },
        "endpoint": {
          "type": "string"
        },
        "node_did": {
          "type": "string"
        },
        "profile_id": {
          "type": "string"
        }
      },
      "required": [
        "access",
        "endpoint",
        "node_did",
        "profile_id"
      ],
      "type": "object"
    },
    "ProvidedBy": {
      "description": "Who provides a command found on a runtime.",
      "oneOf": [
        {
          "description": "The standard layer: under `$BUCKYOS_ROOT`, outside `tools/`.",
          "enum": [
            "buckyos_root"
          ],
          "type": "string"
        },
        {
          "description": "An extension package: under `$BUCKYOS_ROOT/tools`.",
          "enum": [
            "exttools"
          ],
          "type": "string"
        },
        {
          "description": "The Agent's own (`<agent_root>/tools`).",
          "enum": [
            "agent"
          ],
          "type": "string"
        },
        {
          "description": "Beside a development build of the program: serves as a standard helper, and views say so.",
          "enum": [
            "dev"
          ],
          "type": "string"
        },
        {
          "description": "The machine's own PATH.",
          "enum": [
            "system"
          ],
          "type": "string"
        }
      ]
    },
    "ResolvedCommand": {
      "description": "Where a check found a command. `version` comes from a full check only.",
      "properties": {
        "path": {
          "type": "string"
        },
        "provided_by": {
          "$ref": "#/definitions/ProvidedBy"
        },
        "stub": {
          "description": "A full check found it does not run (exit 126 / 127): it counts as missing.",
          "type": "boolean"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "path",
        "provided_by"
      ],
      "type": "object"
    },
    "RuntimeAvailability": {
      "enum": [
        "available",
        "runtime_unavailable",
        "permission_denied"
      ],
      "type": "string"
    },
    "RuntimeBaseline": {
      "description": "Declared environment baseline of an execution runtime: `standard` has the core Agent tools and BuckyOS access, `extended` adds build tool chains and heavy tools. Declared by whoever registers the runtime, never probed.",
      "enum": [
        "standard",
        "extended"
      ],
      "type": "string"
    },
    "RuntimeCaps": {
      "description": "What the machine can do: learned when the runtime is checked. `baseline` is what the runtime is declared to provide (a node's policy, a device's profile, the registrar of a hand-registered one).",
      "properties": {
        "arch": {
          "default": "",
          "type": "string"
        },
        "baseline": {
          "allOf": [
            {
              "$ref": "#/definitions/RuntimeBaseline"
            }
          ],
          "default": "standard",
          "description": "Declared (Q5): decides the sessions' cmd_skills and what their prompts say."
        },
        "baseline_check": {
          "anyOf": [
            {
              "$ref": "#/definitions/BaselineCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "buckyos_root": {
          "description": "`$BUCKYOS_ROOT` of that machine as its executor reports it; a machine without a managed install has none.",
          "type": [
            "string",
            "null"
          ]
        },
        "desktop": {
          "default": false,
          "description": "A desktop session the executor can observe or control.",
          "type": "boolean"
        },
        "desktop_error": {
          "type": [
            "string",
            "null"
          ]
        },
        "identity_mode": {
          "description": "`current_user` / `switch_user`: how a node executes.",
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "default": "",
          "type": "string"
        },
        "shell": {
          "default": "",
          "type": "string"
        },
        "tools_check": {
          "anyOf": [
            {
              "$ref": "#/definitions/ToolsCheck"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RuntimeConnector": {
      "description": "How a runtime is reached: the only type tag of a record.",
      "oneOf": [
        {
          "description": "This process's own environment.",
          "properties": {
            "aliases": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "computer": {
              "anyOf": [
                {
                  "$ref": "#/definitions/NativeComputerConfig"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "enum": [
                "native"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A Node Executor: a node's embedded one (`node_did`) or a standalone executor (`executor_id`, form B), logged in under `profile_id`.",
          "properties": {
            "executor_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "node_did": {
              "type": [
                "string",
                "null"
              ]
            },
            "profile_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "node_executor"
              ],
              "type": "string"
            }
          },
          "required": [
            "profile_id",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "host": {
              "type": "string"
            },
            "identity_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "format": "uint16",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "enum": [
                "ssh"
              ],
              "type": "string"
            },
            "user": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "host",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "RuntimeGrant": {
      "description": "What the runtime allows: its own configuration (a node's `owner_agents` policy, a device's issued profile and term), learned when it is probed; never set per agent. `roots` is the executor's boundary (empty: unlimited); the agent's directories follow the directory convention (`<owner home>/agents/<agent_id>` on the private runtime, `<account home>/.opendan/<agent_id>` on a node) and are not recorded.",
      "properties": {
        "computer": {
          "allOf": [
            {
              "$ref": "#/definitions/ComputerAccess"
            }
          ],
          "default": "none"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "ops": {
          "default": [],
          "description": "Executor operations allowed; empty before the executor was asked.",
          "items": {
            "$ref": "#/definitions/ExecutorOp"
          },
          "type": "array"
        },
        "roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "RuntimeLifecycle": {
      "description": "`retired`: removed from the agent, its device revoked or deleted, or unregistered; kept for its history, never a candidate. An expired runtime stays `active` and unavailable until it is renewed.",
      "enum": [
        "active",
        "retired"
      ],
      "type": "string"
    },
    "RuntimeUsage": {
      "description": "How the agent has used a runtime (the \"runtimes used\" view).",
      "properties": {
        "last_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_used_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sessions_total": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "workspaces": {
          "default": 0,
          "description": "Workspaces created or imported there.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ToolsCheck": {
      "description": "Commands beyond the standard tools verified to exist on a runtime (`check --commands`).",
      "properties": {
        "checked_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "present": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "resolved": {
          "additionalProperties": {
            "$ref": "#/definitions/ResolvedCommand"
          },
          "default": {},
          "description": "Where each command found is.",
          "type": "object"
        }
      },
      "required": [
        "checked_at_ms"
      ],
      "type": "object"
    }
  },
  "properties": {
    "availability": {
      "$ref": "#/definitions/RuntimeAvailability"
    },
    "builtin": {
      "default": false,
      "description": "Created by the host; cannot be unregistered.",
      "type": "boolean"
    },
    "caps": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeCaps"
        }
      ],
      "default": {
        "arch": "",
        "baseline": "standard",
        "desktop": false,
        "os": "",
        "shell": ""
      }
    },
    "checked_at_ms": {
      "default": null,
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "connector": {
      "$ref": "#/definitions/RuntimeConnector"
    },
    "default": {
      "default": false,
      "description": "The owner's default runtime (`default_runtime_id`): the machine the owner means by \"my computer\" and where the owner's absolute paths are read; it may also be the private runtime.",
      "type": "boolean"
    },
    "desc": {
      "default": "",
      "description": "One sentence for people and the model.",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "description": "Switched on in the owner's settings (a disabled runtime keeps its record and says why it is unavailable).",
      "type": "boolean"
    },
    "grant": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeGrant"
        }
      ],
      "default": {
        "computer": "none",
        "ops": [],
        "roots": []
      }
    },
    "last_error": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeLifecycle"
        }
      ],
      "default": "active"
    },
    "name": {
      "type": "string"
    },
    "registered_at_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "registered_by": {
      "type": "string"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "runtime_host": {
      "description": "`native_host_id()` of the host that registered it.",
      "type": "string"
    },
    "runtime_id": {
      "type": "string"
    },
    "updated_at_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "usage": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeUsage"
        }
      ],
      "default": {
        "sessions_total": 0,
        "workspaces": 0
      }
    },
    "version": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "availability",
    "connector",
    "name",
    "registered_at_ms",
    "registered_by",
    "revision",
    "runtime_host",
    "runtime_id",
    "updated_at_ms",
    "version"
  ],
  "title": "RuntimeRecord",
  "type": "object"
}