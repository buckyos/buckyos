{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "BaselineCheck": {
      "description": "The last check of a runtime's standard tools ([`crate::baseline`]): only a hint, the declaration decides (Q5).",
      "properties": {
        "checked_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "error": {
          "description": "Why the check could not run (the runtime was not reachable).",
          "type": [
            "string",
            "null"
          ]
        },
        "missing": {
          "default": [],
          "description": "Standard commands not found on the runtime's PATH.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "ok": {
          "type": "boolean"
        }
      },
      "required": [
        "checked_at_ms",
        "ok"
      ],
      "type": "object"
    },
    "ComputerAccess": {
      "description": "ComputerUse capability of an Agent on a runtime: `none` grants no Computer operation, `observe` grants inspect/observe, `control` adds act.",
      "enum": [
        "none",
        "observe",
        "control"
      ],
      "type": "string"
    },
    "ExecutorOp": {
      "oneOf": [
        {
          "enum": [
            "open_stream",
            "describe",
            "exec",
            "read",
            "write",
            "edit",
            "computer_inspect",
            "computer_observe",
            "computer_act",
            "query",
            "cancel"
          ],
          "type": "string"
        },
        {
          "description": "Create a directory (and missing parents inside the roots).",
          "enum": [
            "mkdir"
          ],
          "type": "string"
        },
        {
          "description": "Whether a path is a file, a directory or missing.",
          "enum": [
            "stat"
          ],
          "type": "string"
        },
        {
          "description": "Move a regular file inside the roots (atomic commit of a transfer).",
          "enum": [
            "rename"
          ],
          "type": "string"
        },
        {
          "description": "Delete a regular file inside the roots.",
          "enum": [
            "remove"
          ],
          "type": "string"
        }
      ]
    },
    "InstallGrant": {
      "description": "What an Agent may install on a runtime.",
      "oneOf": [
        {
          "enum": [
            "none"
          ],
          "type": "string"
        },
        {
          "description": "Commands a skill brings, into the Agent's own bin.",
          "enum": [
            "agent_bin"
          ],
          "type": "string"
        },
        {
          "description": "System-wide packages (ExtTools, package managers).",
          "enum": [
            "system"
          ],
          "type": "string"
        }
      ]
    },
    "RuntimeAvailability": {
      "enum": [
        "available",
        "runtime_unavailable",
        "permission_denied"
      ],
      "type": "string"
    },
    "RuntimeBaseline": {
      "description": "Declared environment baseline of an execution runtime: `standard` has the core Agent tools and BuckyOS access, `extended` adds build tool chains and heavy tools. Declared by whoever registers the runtime, never probed.",
      "enum": [
        "standard",
        "extended"
      ],
      "type": "string"
    },
    "RuntimeCaps": {
      "description": "What the machine can do: learned when the runtime is checked, except `baseline`, which its registrar declares.",
      "properties": {
        "arch": {
          "default": "",
          "type": "string"
        },
        "baseline": {
          "allOf": [
            {
              "$ref": "#/definitions/RuntimeBaseline"
            }
          ],
          "default": "standard",
          "description": "Declared (Q5): decides the sessions' cmd_skills and what their prompts say."
        },
        "baseline_check": {
          "anyOf": [
            {
              "$ref": "#/definitions/BaselineCheck"
            },
            {
              "type": "null"
            }
          ]
        },
        "desktop": {
          "default": false,
          "description": "A desktop session the executor can observe or control.",
          "type": "boolean"
        },
        "identity_mode": {
          "description": "`current_user` / `switch_user`: how a node executes.",
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "default": "",
          "type": "string"
        },
        "shell": {
          "default": "",
          "type": "string"
        },
        "tools_check": {
          "anyOf": [
            {
              "$ref": "#/definitions/ToolsCheck"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "RuntimeConnector": {
      "description": "How a runtime is reached: the only type tag of a record.",
      "oneOf": [
        {
          "description": "This process's own environment.",
          "properties": {
            "type": {
              "enum": [
                "native"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A Node Executor: a node's embedded one (`node_did`) or a standalone executor (`executor_id`, form B), logged in under `profile_id`.",
          "properties": {
            "executor_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "node_did": {
              "type": [
                "string",
                "null"
              ]
            },
            "profile_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "node_executor"
              ],
              "type": "string"
            }
          },
          "required": [
            "profile_id",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "host": {
              "type": "string"
            },
            "identity_file": {
              "type": [
                "string",
                "null"
              ]
            },
            "port": {
              "format": "uint16",
              "minimum": 0.0,
              "type": [
                "integer",
                "null"
              ]
            },
            "type": {
              "enum": [
                "ssh"
              ],
              "type": "string"
            },
            "user": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "host",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "RuntimeGrant": {
      "description": "What this agent may do on the runtime: the node policy narrowed by the owner, with the daemon URL's term. `roots` is the executor's boundary (empty: unlimited); the agent's directories follow the directory convention (`<owner home>/agents/<agent_id>` on the private runtime, `<account home>/.opendan/<agent_id>` on a node) and are not recorded.",
      "properties": {
        "computer": {
          "allOf": [
            {
              "$ref": "#/definitions/ComputerAccess"
            }
          ],
          "default": "none"
        },
        "expires_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "install": {
          "allOf": [
            {
              "$ref": "#/definitions/InstallGrant"
            }
          ],
          "default": "none"
        },
        "ops": {
          "default": [],
          "description": "Executor operations granted; empty before the executor was asked.",
          "items": {
            "$ref": "#/definitions/ExecutorOp"
          },
          "type": "array"
        },
        "roots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspace": {
          "default": false,
          "description": "Long-lived workspaces may be created there.",
          "type": "boolean"
        }
      },
      "type": "object"
    },
    "RuntimeLifecycle": {
      "description": "`retired`: withdrawn, expired or unregistered; kept for its history, never a candidate.",
      "enum": [
        "active",
        "retired"
      ],
      "type": "string"
    },
    "RuntimeUsage": {
      "description": "How the agent has used a runtime (the \"runtimes used\" view).",
      "properties": {
        "last_session_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_used_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sessions_total": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "skill_commands": {
          "default": [],
          "description": "Skill commands installed there.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "workspaces": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "ToolsCheck": {
      "description": "Commands beyond the standard tools verified to exist on a runtime (`check --commands`, skill installation).",
      "properties": {
        "checked_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "missing": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "present": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "checked_at_ms"
      ],
      "type": "object"
    }
  },
  "properties": {
    "availability": {
      "$ref": "#/definitions/RuntimeAvailability"
    },
    "builtin": {
      "default": false,
      "description": "Created by the host; cannot be unregistered.",
      "type": "boolean"
    },
    "caps": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeCaps"
        }
      ],
      "default": {
        "arch": "",
        "baseline": "standard",
        "desktop": false,
        "os": "",
        "shell": ""
      }
    },
    "checked_at_ms": {
      "default": null,
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "connector": {
      "$ref": "#/definitions/RuntimeConnector"
    },
    "default": {
      "default": false,
      "description": "The owner's default runtime (`default_runtime_id`): the machine the owner means by \"my computer\" and where the owner's absolute paths are read; never where a chat runs.",
      "type": "boolean"
    },
    "desc": {
      "default": "",
      "description": "One sentence for people and the model.",
      "type": "string"
    },
    "enabled": {
      "default": true,
      "description": "Switched on in the owner's settings (a disabled runtime keeps its record and says why it is unavailable).",
      "type": "boolean"
    },
    "grant": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeGrant"
        }
      ],
      "default": {
        "computer": "none",
        "install": "none",
        "ops": [],
        "roots": [],
        "workspace": false
      }
    },
    "last_error": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "lifecycle": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeLifecycle"
        }
      ],
      "default": "active"
    },
    "name": {
      "type": "string"
    },
    "registered_at_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "registered_by": {
      "type": "string"
    },
    "revision": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "runtime_host": {
      "description": "`native_host_id()` of the host that registered it.",
      "type": "string"
    },
    "runtime_id": {
      "type": "string"
    },
    "updated_at_ms": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "usage": {
      "allOf": [
        {
          "$ref": "#/definitions/RuntimeUsage"
        }
      ],
      "default": {
        "sessions_total": 0,
        "skill_commands": [],
        "workspaces": 0
      }
    },
    "version": {
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "availability",
    "connector",
    "name",
    "registered_at_ms",
    "registered_by",
    "revision",
    "runtime_host",
    "runtime_id",
    "updated_at_ms",
    "version"
  ],
  "title": "RuntimeRecord",
  "type": "object"
}