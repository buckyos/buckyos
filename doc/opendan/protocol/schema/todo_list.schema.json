{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "DispatchState": {
      "description": "Dispatch of an attempt (crash recovery: a `dispatching` attempt is reconciled against the registry by its sub session id).",
      "enum": [
        "dispatching",
        "dispatched"
      ],
      "type": "string"
    },
    "ReportRef": {
      "description": "Where the report of an attempt is: the final report of its sub session.",
      "properties": {
        "report_id": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "session_id"
      ],
      "type": "object"
    },
    "TodoAttempt": {
      "properties": {
        "artifacts": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attempt": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "baseline": {
          "description": "The declared baseline of that runtime (`standard | extended`).",
          "type": [
            "string",
            "null"
          ]
        },
        "behavior": {
          "description": "The behavior its sub session started with.",
          "type": [
            "string",
            "null"
          ]
        },
        "child_sid": {
          "description": "The work session executing the attempt.",
          "type": [
            "string",
            "null"
          ]
        },
        "dispatch": {
          "anyOf": [
            {
              "$ref": "#/definitions/DispatchState"
            },
            {
              "type": "null"
            }
          ]
        },
        "ended_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "mode": {
          "$ref": "#/definitions/TodoMode"
        },
        "paused_at_ms": {
          "description": "The plan paused its work session (it infers no more until resumed).",
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "reason": {
          "description": "Why this attempt was made (a retry's reason).",
          "type": [
            "string",
            "null"
          ]
        },
        "report": {
          "anyOf": [
            {
              "$ref": "#/definitions/ReportRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "resumed_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "runtime_id": {
          "description": "Where the attempt executes, as resolved at its start (the Todo keeps the intent; a retry resolves again).",
          "type": [
            "string",
            "null"
          ]
        },
        "started_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "status": {
          "allOf": [
            {
              "$ref": "#/definitions/TodoStatus"
            }
          ],
          "description": "`running | completed | failed | timeout | stopped`."
        },
        "summary": {
          "description": "One line about the result.",
          "type": [
            "string",
            "null"
          ]
        },
        "workspace_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "attempt",
        "mode",
        "started_at_ms",
        "status"
      ],
      "type": "object"
    },
    "TodoMode": {
      "description": "How an attempt runs. Both run in a work session of their own.",
      "oneOf": [
        {
          "description": "Work (behavior `work_simple`, the plan's workspace), in the order of its `after` chain.",
          "enum": [
            "serial"
          ],
          "type": "string"
        },
        {
          "description": "A read-only investigation (behavior `explore`, no workspace).",
          "enum": [
            "explore"
          ],
          "type": "string"
        }
      ]
    },
    "TodoRecord": {
      "properties": {
        "accept": {
          "description": "Acceptance criteria.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "after": {
          "description": "Todos that must have completed before this one runs.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "attempts": {
          "items": {
            "$ref": "#/definitions/TodoAttempt"
          },
          "type": "array"
        },
        "batch": {
          "description": "Dispatch batch (explorations sent out together).",
          "type": [
            "string",
            "null"
          ]
        },
        "behavior": {
          "description": "The behavior a sub session executing the Todo starts with (`None`: the mode's default); set when it is first dispatched, so a retry runs the same way.",
          "type": [
            "string",
            "null"
          ]
        },
        "block_reason": {
          "description": "Why the last dispatch failed (cleared by `update` / `retry`).",
          "type": [
            "string",
            "null"
          ]
        },
        "blocked_by": {
          "description": "Todos of `after` that ended without success: this one waits for the plan (retry them, change `after`, or cancel it).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "cancel_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "content": {
          "type": "string"
        },
        "created_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "evidence": {
          "description": "Evidence already known.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "mode": {
          "$ref": "#/definitions/TodoMode"
        },
        "retry": {
          "description": "Pending retry: the reason for the next attempt.",
          "type": [
            "string",
            "null"
          ]
        },
        "rev": {
          "description": "Revision of this record (+1 on every change).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "runtime_id": {
          "description": "Where the Todo must execute: a session-runtime id (`None`: the session's own), and `inherit | none | <workspace id>` (`None`: a serial Todo inherits the session's workspace, an exploration takes none). The two are chosen independently: a workspace on another runtime than the work's is reached by copying files.",
          "type": [
            "string",
            "null"
          ]
        },
        "scope": {
          "type": [
            "string",
            "null"
          ]
        },
        "seq": {
          "description": "Creation order.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "skills": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "status": {
          "$ref": "#/definitions/TodoStatus"
        },
        "title": {
          "type": "string"
        },
        "todo_id": {
          "description": "Stable, never reused (`T01`, `T02`, … from the list's counter).",
          "type": "string"
        },
        "updated_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "updates": {
          "items": {
            "$ref": "#/definitions/TodoUpdate"
          },
          "type": "array"
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "content",
        "created_at_ms",
        "mode",
        "rev",
        "seq",
        "status",
        "title",
        "todo_id",
        "updated_at_ms"
      ],
      "type": "object"
    },
    "TodoStatus": {
      "oneOf": [
        {
          "enum": [
            "pending",
            "running",
            "completed",
            "failed",
            "timeout",
            "stopped",
            "cancelled"
          ],
          "type": "string"
        },
        {
          "description": "Not dispatched and not dispatchable until the plan decides: a Todo it runs after ended without success (`blocked_by`), or its dispatch failed (`block_reason`).",
          "enum": [
            "blocked"
          ],
          "type": "string"
        }
      ]
    },
    "TodoUpdate": {
      "description": "One change of a Todo after it was added (`todo update`).",
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "attempt": {
          "description": "The attempt that was running and was told (`None`: none ran).",
          "format": "uint32",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "by": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "description": "The fields it changed.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "reason": {
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "fields",
        "reason"
      ],
      "type": "object"
    }
  },
  "properties": {
    "next_seq": {
      "description": "Counter of todo ids: never reused, also after cancellations.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "rev": {
      "description": "Revision of the list (+1 on every change).",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "schema": {
      "type": "string"
    },
    "todos": {
      "default": [],
      "items": {
        "$ref": "#/definitions/TodoRecord"
      },
      "type": "array"
    }
  },
  "required": [
    "next_seq",
    "rev",
    "schema"
  ],
  "title": "TodoList",
  "type": "object"
}