{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Acceptance": {
      "enum": [
        "n/a",
        "pending",
        "accepted",
        "discarded"
      ],
      "type": "string"
    },
    "Activity": {
      "description": "What this session is doing and roughly what it modifies (§6.7).",
      "properties": {
        "heartbeat_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "touching": {
          "items": {
            "$ref": "#/definitions/Touching"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "CallTrigger": {
      "description": "How a sub context was called, i.e. where its result returns to.",
      "oneOf": [
        {
          "description": "`next_behavior` of a complete Step: the result returns as `process_result` in the caller's hand-over batch.",
          "properties": {
            "kind": {
              "enum": [
                "behavior"
              ],
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "description": "A tool call / behavior action: the caller is suspended on `PendingTool`, the result is filled as the tool result of `call_id`.",
          "properties": {
            "call_id": {
              "type": "string"
            },
            "kind": {
              "enum": [
                "tool"
              ],
              "type": "string"
            },
            "task_id": {
              "type": "string"
            }
          },
          "required": [
            "call_id",
            "kind",
            "task_id"
          ],
          "type": "object"
        }
      ]
    },
    "ChildCall": {
      "description": "The sub context a `Caller` frame waits for.",
      "properties": {
        "behavior": {
          "type": "string"
        },
        "mode": {
          "allOf": [
            {
              "$ref": "#/definitions/ContextMode"
            }
          ],
          "description": "`create_sub_context | fork` (how the child was constructed)."
        },
        "task": {
          "description": "Task given to the child (tool trigger: the call's `task` argument).",
          "type": [
            "string",
            "null"
          ]
        },
        "trigger": {
          "$ref": "#/definitions/CallTrigger"
        }
      },
      "required": [
        "behavior",
        "mode",
        "trigger"
      ],
      "type": "object"
    },
    "ContextMode": {
      "description": "How a behavior is entered when a hand-over (`next_behavior`) or a `call_behavior` tool call names it. Decided by the target behavior, never by the session as a whole; there is no default mode.",
      "oneOf": [
        {
          "description": "The target has its own context (system, tools, history, run): created on first entry, resumed from its own snapshot afterwards.",
          "enum": [
            "switch_context"
          ],
          "type": "string"
        },
        {
          "description": "A new sub context per call with the target's system and task input, plus an explicit selection of the caller's history; its result returns to the caller.",
          "enum": [
            "create_sub_context"
          ],
          "type": "string"
        },
        {
          "description": "A new branch per call that keeps the caller's system and its complete effective history at the fork point; its result returns to the caller.",
          "enum": [
            "fork"
          ],
          "type": "string"
        }
      ]
    },
    "EventSource": {
      "description": "Where an event comes from.",
      "properties": {
        "id": {
          "default": "",
          "description": "object: object id; session: sid; task: task_id; timer: timer name; system: may be empty.",
          "type": "string"
        },
        "kind": {
          "description": "`object | session | task | timer | system`; unknown kinds are not a format error (an event without a matching subscription is dropped).",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "FrameRole": {
      "description": "Why a run sits in `process_stack`.",
      "oneOf": [
        {
          "description": "A context left through SWITCH_CONTEXT: re-entered when a hand-over names its entry again.",
          "enum": [
            "parked"
          ],
          "type": "string"
        },
        {
          "description": "The caller of a sub context (create-sub-context / fork): live again when the child returns.",
          "enum": [
            "caller"
          ],
          "type": "string"
        }
      ]
    },
    "InputPos": {
      "description": "Delivery position of a bus record.",
      "properties": {
        "index": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "src": {
          "type": "string"
        }
      },
      "required": [
        "index",
        "src"
      ],
      "type": "object"
    },
    "LiveRun": {
      "description": "A run that is not finished yet (xllm run directory).",
      "properties": {
        "applied_input_seq": {
          "default": 0,
          "description": "Receipt batches of this run already applied to state (§8.3).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_epoch": {
          "description": "History epoch (`HostMeta.history_epoch`) `flushed_message_count` counts in. A snapshot of a newer epoch starts at zero: its whole history before the rewrite was flushed before the rewrite was published.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_input_seq": {
          "default": 0,
          "description": "Behavior runs: receipts (injected messages) with `input_seq ≤` this are in the worklog.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_message_count": {
          "description": "Function call runs: messages after the history prefix (within `flushed_epoch`) already in the worklog.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_step_index": {
          "description": "Behavior runs: steps with `step_index <` this are in the worklog (identity high-water mark, not a count: inherited steps of a fork child and steps rewritten away are never written).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "handover_at_ms": {
          "description": "`at_ms` of the run's hand-over record (run.json `handover`) this state already committed: a record with this stamp is not a transfer left to do.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "process_entry": {
          "description": "Process entry the run belongs to (behavior process ↔ run).",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "turns": {
          "default": [],
          "items": {
            "$ref": "#/definitions/TurnInputs"
          },
          "type": "array"
        }
      },
      "required": [
        "run_id"
      ],
      "type": "object"
    },
    "OpenTurn": {
      "description": "The logical Turn in progress (one Input → result of the AgentSession).\n\nOpened by the first input batch committed while no Turn is open (bootstrap, msg / event). Context switches, sub context calls and returns, observation injections, resumable suspensions (interrupt, retryable error, context limit, pending tool), history epoch rewrites and restarts keep it open; inputs consumed while it is open join it. Only the session closes it, when it interprets an outcome as the Turn's result or failure ([`TurnStatus`]).",
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "has_msg": {
          "description": "A message (not only events) is among them.",
          "type": "boolean"
        },
        "hook": {
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "description": "Session-wide Turn number, starting at 1.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "input_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "inputs": {
          "description": "msg / event inputs that make up the Turn's logical input: those of the opening batch, then those consumed while it was open.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "run_id": {
          "description": "Input batch that opened it: `(run_id, input_seq)`.",
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "index",
        "input_seq",
        "run_id"
      ],
      "type": "object"
    },
    "OutboxEntry": {
      "description": "One outbound message of a session.",
      "properties": {
        "attempts": {
          "default": 0,
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "deliveries": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "error": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "Idempotency key: `(sid, turn, run_id, n)`.",
          "type": "string"
        },
        "msg": {
          "description": "The complete message, `created_at_ms` included: re-sent unchanged."
        },
        "msg_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "$ref": "#/definitions/OutboxStatus"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "updated_at_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "msg",
        "status",
        "turn"
      ],
      "type": "object"
    },
    "OutboxStatus": {
      "oneOf": [
        {
          "enum": [
            "sent"
          ],
          "type": "string"
        },
        {
          "description": "Not handed to the outbound sink yet, or the hand-over failed in a way worth retrying.",
          "enum": [
            "pending"
          ],
          "type": "string"
        },
        {
          "description": "Refused (route mismatch, rejected by the message service); never retried.",
          "enum": [
            "failed"
          ],
          "type": "string"
        }
      ]
    },
    "Outcome": {
      "enum": [
        "succeeded",
        "failed",
        "stopped"
      ],
      "type": "string"
    },
    "PendingEvent": {
      "description": "Semi-subscription state waiting to be injected: the newest version of one `(subscription_id, source)`, its terminal event kept separately. Saved when received (the delivery is then consumed); cleared only by the receipt of the batch that injected exactly these versions, by `unsubscribe`, or replaced by a newer version.",
      "properties": {
        "latest": {
          "anyOf": [
            {
              "$ref": "#/definitions/PendingEventVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source": {
          "$ref": "#/definitions/EventSource"
        },
        "subscription_id": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "superseded": {
          "default": 0,
          "description": "Versions replaced before they were injected.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "terminal": {
          "anyOf": [
            {
              "$ref": "#/definitions/PendingEventVersion"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Never replaced by later non-terminal versions."
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "PendingEventVersion": {
      "description": "One version of an observed source's state.",
      "properties": {
        "data_ref": {
          "default": null,
          "type": [
            "string",
            "null"
          ]
        },
        "event": {
          "type": "string"
        },
        "input": {
          "anyOf": [
            {
              "$ref": "#/definitions/InputPos"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Where it was delivered (`None`: synthesized by the runner, e.g. a pull-mode session subscription)."
        },
        "key": {
          "type": "string"
        },
        "received_at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "seq": {
          "default": null,
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        }
      },
      "required": [
        "event",
        "key",
        "received_at_ms",
        "summary"
      ],
      "type": "object"
    },
    "ProcessFrame": {
      "description": "Suspended behavior process (its run is kept, §4.4).",
      "properties": {
        "applied_input_seq": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "call": {
          "anyOf": [
            {
              "$ref": "#/definitions/ChildCall"
            },
            {
              "type": "null"
            }
          ],
          "description": "`Caller` frames: the child being waited for."
        },
        "entry": {
          "type": "string"
        },
        "flushed_epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_input_seq": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_message_count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_step_index": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "handover_at_ms": {
          "description": "`at_ms` of the hand-over record this suspension committed (see [`LiveRun::handover_at_ms`]).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "role": {
          "$ref": "#/definitions/FrameRole"
        },
        "run_id": {
          "type": "string"
        },
        "turns": {
          "default": [],
          "items": {
            "$ref": "#/definitions/TurnInputs"
          },
          "type": "array"
        }
      },
      "required": [
        "entry",
        "role",
        "run_id"
      ],
      "type": "object"
    },
    "RecentKeys": {
      "description": "Bounded dedup cache of producer `key`s (§4.5). It only filters duplicate deliveries; it never replaces the receipts persisted in snapshots or the per-source consumption positions.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "ReplyRoute": {
      "description": "Default reply path of a session.",
      "oneOf": [
        {
          "description": "Reply the way the last consumed input message came.",
          "properties": {
            "kind": {
              "description": "MsgObject kind of the reply.",
              "type": "string"
            },
            "reply_to": {
              "default": null,
              "description": "ObjId of the message replied to.",
              "type": [
                "string",
                "null"
              ]
            },
            "route": {
              "enum": [
                "message"
              ],
              "type": "string"
            },
            "to": {
              "description": "The sender (one-to-one) or the group.",
              "type": "string"
            },
            "to_session": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "tunnel": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "kind",
            "route",
            "to"
          ],
          "type": "object"
        },
        {
          "description": "Hand the result back to the parent session.",
          "properties": {
            "route": {
              "enum": [
                "parent_session"
              ],
              "type": "string"
            },
            "session_id": {
              "type": "string"
            }
          },
          "required": [
            "route",
            "session_id"
          ],
          "type": "object"
        }
      ]
    },
    "RunState": {
      "enum": [
        "created",
        "ready",
        "running",
        "waiting",
        "finished"
      ],
      "type": "string"
    },
    "SourceProgress": {
      "description": "Consumption progress of one input source (§4.5).",
      "properties": {
        "accepted": {
          "description": "Input events accepted by an active subscription that are still pending: their routing was decided when they were first seen, so a later `unsubscribe` does not turn them into dropped events.",
          "items": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "acked_index": {
          "default": 0,
          "description": "Highest index acknowledged-able: every index ≤ this was consumed.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "consumed_above": {
          "description": "Consumed indices above `acked_index` (selective consumption).",
          "items": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "type": "object"
    },
    "Topic": {
      "properties": {
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Touching": {
      "properties": {
        "kind": {
          "description": "`path | object | artifact`.",
          "type": "string"
        },
        "mode": {
          "default": "write",
          "description": "`read | write`.",
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "since_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "type": "object"
    },
    "TurnInputs": {
      "description": "Inputs of one logical Turn that entered a run. The input batch that opens the Turn (or the first batch of an already open Turn in this run) starts an entry; later batches of the same Turn (hand-over, observation, supplementary input) extend it, so the list grows with Turns, not with batches.",
      "properties": {
        "at_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "events": {
          "description": "Keys of the semi-subscription state versions injected with them.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hook": {
          "description": "Controlled input of the first batch (`on_init`, `on_input`, `on_context_switch`).",
          "type": [
            "string",
            "null"
          ]
        },
        "input_seq": {
          "default": 0,
          "description": "`input_seq` of the first batch of this Turn in the run.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "inputs": {
          "description": "Stable input ids, e.g. `q#121`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "turn"
      ],
      "type": "object"
    },
    "WaitingFor": {
      "properties": {
        "deadline_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/definitions/WaitingKind"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "WaitingKind": {
      "description": "What a waiting session waits for (`waiting_for.kind`).",
      "enum": [
        "input",
        "tool",
        "event",
        "children"
      ],
      "type": "string"
    },
    "WorklogBoundary": {
      "properties": {
        "committed_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "committed_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "committed_bytes",
        "committed_seq"
      ],
      "type": "object"
    },
    "WriterInfo": {
      "properties": {
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "lock_epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "pid": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "principal": {
          "type": "string"
        },
        "runner_id": {
          "type": "string"
        }
      },
      "required": [
        "lock_epoch",
        "pid",
        "principal",
        "runner_id"
      ],
      "type": "object"
    }
  },
  "properties": {
    "acceptance": {
      "allOf": [
        {
          "$ref": "#/definitions/Acceptance"
        }
      ],
      "default": "n/a"
    },
    "activity": {
      "allOf": [
        {
          "$ref": "#/definitions/Activity"
        }
      ],
      "default": {
        "heartbeat_ms": 0,
        "summary": ""
      }
    },
    "bootstrap_done": {
      "default": false,
      "type": "boolean"
    },
    "current_behavior": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/definitions/SourceProgress"
      },
      "default": {},
      "description": "Per input source consumption progress, keyed by source id.",
      "type": "object"
    },
    "internal_continuation": {
      "description": "An input batch to commit without new input (context switch, sub context call / return through `next_behavior`); it joins the open Turn.",
      "type": [
        "string",
        "null"
      ]
    },
    "last_error": true,
    "last_run": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "live_run": {
      "anyOf": [
        {
          "$ref": "#/definitions/LiveRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "one_line_status": {
      "default": "",
      "type": "string"
    },
    "open_turn": {
      "anyOf": [
        {
          "$ref": "#/definitions/OpenTurn"
        },
        {
          "type": "null"
        }
      ],
      "description": "The Turn in progress, if any."
    },
    "outbox": {
      "description": "Replies produced by committed Turns and their delivery: written in the commit that closes the Turn, sent afterwards, re-sent as they are after a restart (the idempotency key and the message never change).",
      "items": {
        "$ref": "#/definitions/OutboxEntry"
      },
      "type": "array"
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/definitions/Outcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_decision": {
      "description": "Decisions seen in the queue but not applied yet (UI display)."
    },
