{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Acceptance": {
      "enum": [
        "n/a",
        "pending",
        "accepted",
        "discarded"
      ],
      "type": "string"
    },
    "Activity": {
      "description": "What this session is doing and roughly what it modifies (§6.7).",
      "properties": {
        "heartbeat_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "touching": {
          "items": {
            "$ref": "#/definitions/Touching"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "LiveRun": {
      "description": "A run that is not finished yet (xllm run directory).",
      "properties": {
        "applied_input_seq": {
          "default": 0,
          "description": "Receipt batches of this run already applied to state (§8.3).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_epoch": {
          "description": "History epoch (`HostMeta.history_epoch`) `flushed_message_count` counts in. A snapshot of a newer epoch starts at zero: its whole history before the rewrite was flushed before the rewrite was published.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_input_seq": {
          "default": 0,
          "description": "Behavior runs: receipts (injected messages) with `input_seq ≤` this are in the worklog.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_message_count": {
          "description": "Function call runs: messages after the history prefix (within `flushed_epoch`) already in the worklog.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_step_index": {
          "description": "Behavior runs: steps with `step_index <` this are in the worklog (identity high-water mark, not a count: inherited steps of a fork child and steps rewritten away are never written).",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "process_entry": {
          "description": "Process entry the run belongs to (behavior process ↔ run).",
          "type": [
            "string",
            "null"
          ]
        },
        "run_id": {
          "type": "string"
        },
        "turns": {
          "default": [],
          "items": {
            "$ref": "#/definitions/TurnInputs"
          },
          "type": "array"
        }
      },
      "required": [
        "run_id"
      ],
      "type": "object"
    },
    "OpenTurn": {
      "description": "The logical Turn in progress (one Input → result of the AgentSession).\n\nOpened by the first input batch committed while no Turn is open (bootstrap, msg / event). Behavior switches, fork calls and returns, independent context switches, observation injections, resumable suspensions (interrupt, retryable error, context limit, pending tool), history epoch rewrites and restarts keep it open; inputs consumed while it is open join it. Only the session closes it, when it interprets an outcome as the Turn's result or failure ([`TurnStatus`]).",
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "hook": {
          "type": [
            "string",
            "null"
          ]
        },
        "index": {
          "description": "Session-wide Turn number, starting at 1.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "input_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "inputs": {
          "description": "msg / event inputs that make up the Turn's logical input: those of the opening batch, then those consumed while it was open.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "run_id": {
          "description": "Input batch that opened it: `(run_id, input_seq)`.",
          "type": "string"
        }
      },
      "required": [
        "at_ms",
        "index",
        "input_seq",
        "run_id"
      ],
      "type": "object"
    },
    "Outcome": {
      "enum": [
        "succeeded",
        "failed",
        "stopped"
      ],
      "type": "string"
    },
    "ProcessFrame": {
      "description": "Suspended behavior process (its run is kept, §4.4).",
      "properties": {
        "applied_input_seq": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "entry": {
          "type": "string"
        },
        "flushed_epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_input_seq": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_message_count": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "flushed_step_index": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "mode": {
          "$ref": "#/definitions/ProcessMode"
        },
        "run_id": {
          "type": "string"
        },
        "turns": {
          "default": [],
          "items": {
            "$ref": "#/definitions/TurnInputs"
          },
          "type": "array"
        }
      },
      "required": [
        "entry",
        "mode",
        "run_id"
      ],
      "type": "object"
    },
    "ProcessMode": {
      "enum": [
        "fork",
        "independent"
      ],
      "type": "string"
    },
    "RecentKeys": {
      "description": "Bounded dedup cache of producer `key`s (§4.5). It only filters duplicate deliveries; it never replaces the receipts persisted in snapshots or the per-source consumption positions.",
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "RunState": {
      "enum": [
        "created",
        "ready",
        "running",
        "waiting",
        "finished"
      ],
      "type": "string"
    },
    "SourceProgress": {
      "description": "Consumption progress of one input source (§4.5).",
      "properties": {
        "acked_index": {
          "default": 0,
          "description": "Highest index acknowledged-able: every index ≤ this was consumed.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "consumed_above": {
          "description": "Consumed indices above `acked_index` (selective consumption).",
          "items": {
            "format": "uint64",
            "minimum": 0.0,
            "type": "integer"
          },
          "type": "array",
          "uniqueItems": true
        },
        "reading": {
          "description": "msg-center records consumed but not yet marked `Read` (deferred).",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Topic": {
      "properties": {
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "title": {
          "default": "",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Touching": {
      "properties": {
        "kind": {
          "description": "`path | object | artifact`.",
          "type": "string"
        },
        "mode": {
          "default": "write",
          "description": "`read | write`.",
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "since_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "type": "object"
    },
    "TurnInputs": {
      "description": "Inputs of one logical Turn that entered a run. The input batch that opens the Turn (or the first batch of an already open Turn in this run) starts an entry; later batches of the same Turn (hand-over, observation, supplementary input) extend it, so the list grows with Turns, not with batches.",
      "properties": {
        "at_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "changes": {
          "description": "Subscription changes, e.g. `s1@16`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "hook": {
          "description": "Hook point of the first batch (`on_init`, `on_wakeup`, `on_behavior_switch`, `observation`).",
          "type": [
            "string",
            "null"
          ]
        },
        "input_seq": {
          "default": 0,
          "description": "`input_seq` of the first batch of this Turn in the run.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "inputs": {
          "description": "Stable input ids, e.g. `q#121`.",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "turn": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "turn"
      ],
      "type": "object"
    },
    "WaitingFor": {
      "properties": {
        "deadline_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": [
            "integer",
            "null"
          ]
        },
        "kind": {
          "description": "`input | tool | event | children`.",
          "type": "string"
        },
        "refs": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "type": "object"
    },
    "WorklogBoundary": {
      "properties": {
        "committed_bytes": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "committed_seq": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "committed_bytes",
        "committed_seq"
      ],
      "type": "object"
    },
    "WriterInfo": {
      "properties": {
        "host": {
          "type": [
            "string",
            "null"
          ]
        },
        "lock_epoch": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "pid": {
          "format": "uint32",
          "minimum": 0.0,
          "type": "integer"
        },
        "principal": {
          "type": "string"
        },
        "runner_id": {
          "type": "string"
        }
      },
      "required": [
        "lock_epoch",
        "pid",
        "principal",
        "runner_id"
      ],
      "type": "object"
    }
  },
  "properties": {
    "acceptance": {
      "allOf": [
        {
          "$ref": "#/definitions/Acceptance"
        }
      ],
      "default": "n/a"
    },
    "activity": {
      "allOf": [
        {
          "$ref": "#/definitions/Activity"
        }
      ],
      "default": {
        "heartbeat_ms": 0,
        "summary": ""
      }
    },
    "bootstrap_done": {
      "default": false,
      "type": "boolean"
    },
    "current_behavior": {
      "type": [
        "string",
        "null"
      ]
    },
    "inputs": {
      "additionalProperties": {
        "$ref": "#/definitions/SourceProgress"
      },
      "default": {},
      "description": "Per input source consumption progress, keyed by source id.",
      "type": "object"
    },
    "internal_continuation": {
      "description": "An input batch to commit without new input (behavior switch / fork return / independent hand-over); it joins the open Turn.",
      "type": [
        "string",
        "null"
      ]
    },
    "last_error": true,
    "last_run": {
      "default": null,
      "type": [
        "string",
        "null"
      ]
    },
    "live_run": {
      "anyOf": [
        {
          "$ref": "#/definitions/LiveRun"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "one_line_status": {
      "default": "",
      "type": "string"
    },
    "open_turn": {
      "anyOf": [
        {
          "$ref": "#/definitions/OpenTurn"
        },
        {
          "type": "null"
        }
      ],
      "description": "The Turn in progress, if any."
    },
    "outcome": {
      "anyOf": [
        {
          "$ref": "#/definitions/Outcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "pending_decision": {
      "description": "Decisions seen in the queue but not applied yet (UI display)."
    },
    "pending_task_calls": {
      "items": true,
      "type": "array"
    },
    "perception_seq": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "process_entry": {
      "type": [
        "string",
        "null"
      ]
    },
    "process_result": {
      "description": "Result of a fork child process, handed to the resumed parent in its hand-over batch (`{behavior, result}`)."
    },
    "process_stack": {
      "items": {
        "$ref": "#/definitions/ProcessFrame"
      },
      "type": "array"
    },
    "recent_keys": {
      "allOf": [
        {
          "$ref": "#/definitions/RecentKeys"
        }
      ],
      "default": []
    },
    "reported_rev": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "result": true,
    "rev": {
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "run_state": {
      "$ref": "#/definitions/RunState"
    },
    "schema": {
      "type": "string"
    },
    "stop_requested": {
      "default": false,
      "description": "Stop requested through `control(stop)`; applied at the next safe point.",
      "type": "boolean"
    },
    "subscription_cursors": {
      "additionalProperties": true,
      "type": "object"
    },
    "topic": {
      "allOf": [
        {
          "$ref": "#/definitions/Topic"
        }
      ],
      "default": {
        "title": ""
      }
    },
    "turn_seq": {
      "default": 0,
      "description": "Number of the latest Turn opened (0 before the first input batch).",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "turns_completed": {
      "default": 0,
      "description": "Turns closed with [`TurnStatus::Completed`].",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "updated_at_ms": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "waiting_for": {
      "anyOf": [
        {
          "$ref": "#/definitions/WaitingFor"
        },
        {
          "type": "null"
        }
      ]
    },
    "worklog": {
      "allOf": [
        {
          "$ref": "#/definitions/WorklogBoundary"
        }
      ],
      "default": {
        "committed_bytes": 0,
        "committed_seq": 0
      }
    },
    "writer": {
      "anyOf": [
        {
          "$ref": "#/definitions/WriterInfo"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "rev",
    "run_state",
    "schema"
  ],
  "title": "SessionState",
  "type": "object"
}