{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "MsgDelivery": {
      "description": "Delivery layer information; everything optional.",
      "properties": {
        "context": {
          "description": "An earlier message of the conversation, delivered as material for the input that follows it: it never forms an input batch alone, and it carries no request of its own.",
          "type": "boolean"
        },
        "conversation_name": {
          "description": "Display name of the conversation (group name).",
          "type": [
            "string",
            "null"
          ]
        },
        "from_name": {
          "description": "Display name of the speaker.",
          "type": [
            "string",
            "null"
          ]
        },
        "record_id": {
          "description": "msg-center record id (audit).",
          "type": [
            "string",
            "null"
          ]
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/definitions/MsgTrigger"
            },
            {
              "type": "null"
            }
          ],
          "description": "A group message that started a turn: what let it through."
        },
        "tunnel": {
          "description": "DID of the ingress tunnel.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "MsgTrigger": {
      "description": "Why a group message reached the session.",
      "properties": {
        "member": {
          "description": "Another member than the owner.",
          "type": "boolean"
        },
        "reason": {
          "description": "The condition ([`crate::group_trigger`]).",
          "type": "string"
        }
      },
      "required": [
        "reason"
      ],
      "type": "object"
    }
  },
  "description": "`type = \"msg\"` payload: the message object as it is plus what a MsgObject does not carry by design.",
  "properties": {
    "delivery": {
      "$ref": "#/definitions/MsgDelivery"
    },
    "msg": {
      "description": "cyfs-ndn MsgObject v2, never rewritten or trimmed."
    }
  },
  "required": [
    "msg"
  ],
  "title": "SessionMsg",
  "type": "object"
}