{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CheckOutcome": {
      "description": "What a check returned (`true`: the run opportunity became an inference).",
      "enum": [
        "true",
        "false",
        "error"
      ],
      "type": "string"
    },
    "CheckRecord": {
      "description": "The last check the host ran.",
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "elapsed_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "outcome": {
          "$ref": "#/definitions/CheckOutcome"
        },
        "reason": {
          "description": "The script's `reason` (`true`), or the error.",
          "type": [
            "string",
            "null"
          ]
        },
        "script_version": {
          "default": 0,
          "description": "Version of the script that ran.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "at_ms",
        "outcome"
      ],
      "type": "object"
    },
    "GateStats": {
      "description": "What the gate did in the current period (host side; held events are in the Goal State's `holds`).",
      "properties": {
        "checks_error": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "checks_false": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "checks_true": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "guarantees": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "period_start_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "skipped_budget": {
          "default": 0,
          "description": "… by the Goal's period budget or the agent's total.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "skipped_min_interval": {
          "default": 0,
          "description": "Scheduled run opportunities skipped by the hard interval.",
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "type": "object"
    },
    "PendingFire": {
      "description": "A scheduled fire written before it is posted (re-posted with the same key after a crash).",
      "properties": {
        "key": {
          "type": "string"
        },
        "missed": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "slot": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "key",
        "missed",
        "slot"
      ],
      "type": "object"
    },
    "SkippedFire": {
      "properties": {
        "at_ms": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        },
        "reason": {
          "description": "`paused | not_active | min_interval | period_budget | agent_budget | check_false | check_error`.",
          "type": "string"
        },
        "slot": {
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "at_ms",
        "reason",
        "slot"
      ],
      "type": "object"
    }
  },
  "description": "`schedule.json`.",
  "properties": {
    "backend": {
      "description": "`local` (phase 1).",
      "type": "string"
    },
    "check_errors": {
      "default": 0,
      "description": "Checks in a row that failed (thrown, timed out, wrong result).",
      "format": "uint32",
      "minimum": 0.0,
      "type": "integer"
    },
    "check_state": {
      "description": "The `state` the script returned last, given back to the next check."
    },
    "goal_id": {
      "type": "string"
    },
    "guarantee_posted_for_ms": {
      "default": 0,
      "description": "The quiet stretch (its start) the last hard guarantee was posted for: one per stretch.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "last_check": {
      "anyOf": [
        {
          "$ref": "#/definitions/CheckRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_check_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_fire_at_ms": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "last_posted_key": {
      "type": [
        "string",
        "null"
      ]
    },
    "last_slot": {
      "format": "uint64",
      "minimum": 0.0,
      "type": [
        "integer",
        "null"
      ]
    },
    "pending": {
      "anyOf": [
        {
          "$ref": "#/definitions/PendingFire"
        },
        {
          "type": "null"
        }
      ]
    },
    "schema": {
      "type": "string"
    },
    "skipped": {
      "items": {
        "$ref": "#/definitions/SkippedFire"
      },
      "type": "array"
    },
    "start_posted_epoch": {
      "default": 0,
      "description": "Epoch whose start event (`created / reopened / restarted`) was posted.",
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    },
    "stats": {
      "allOf": [
        {
          "$ref": "#/definitions/GateStats"
        }
      ],
      "default": {
        "checks_error": 0,
        "checks_false": 0,
        "checks_true": 0,
        "guarantees": 0,
        "period_start_ms": 0,
        "skipped_budget": 0,
        "skipped_min_interval": 0
      }
    },
    "switched_off": {
      "default": false,
      "description": "A built-in Goal switched off in `agent.toml`: no session, no checks.",
      "type": "boolean"
    },
    "timetable": {
      "description": "The timetable the slots count in (`every:<secs>` | `cron:<expr>@<zone>`; a changed one starts counting again).",
      "type": [
        "string",
        "null"
      ]
    },
    "updated_at_ms": {
      "default": 0,
      "format": "uint64",
      "minimum": 0.0,
      "type": "integer"
    }
  },
  "required": [
    "backend",
    "goal_id",
    "schema"
  ],
  "title": "GoalSchedule",
  "type": "object"
}