{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Subscription": {
      "properties": {
        "id": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/SubscriptionMode"
        },
        "source": {
          "$ref": "#/definitions/SubscriptionSource"
        },
        "watch": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "id",
        "mode",
        "source"
      ],
      "type": "object"
    },
    "SubscriptionMode": {
      "oneOf": [
        {
          "description": "A matching event is an Input: it wakes the session and enters a controlled input batch.",
          "enum": [
            "active"
          ],
          "type": "string"
        },
        {
          "description": "A matching event is an Observe: merged into `pending_events` and shown as the semi-subscription snapshot before the next controlled input; never triggers inference by itself.",
          "enum": [
            "semi"
          ],
          "type": "string"
        }
      ]
    },
    "SubscriptionSource": {
      "oneOf": [
        {
          "description": "Another session of the same agent (pull: registry rev compare; always observed). Also matches bus events with `source = session:<ref>`.",
          "properties": {
            "ref": {
              "type": "string"
            },
            "type": {
              "enum": [
                "session"
              ],
              "type": "string"
            }
          },
          "required": [
            "ref",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "Object events bridged into the bus (`source = object:<object>`). `event` empty or `*` matches every event name.",
          "properties": {
            "event": {
              "default": "",
              "type": "string"
            },
            "object": {
              "type": "string"
            },
            "type": {
              "enum": [
                "object_event"
              ],
              "type": "string"
            }
          },
          "required": [
            "object",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A task (`source = task:<task_id>`).",
          "properties": {
            "task_id": {
              "type": "string"
            },
            "type": {
              "enum": [
                "task"
              ],
              "type": "string"
            }
          },
          "required": [
            "task_id",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A timer (`source = timer:<name>`).",
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "enum": [
                "timer"
              ],
              "type": "string"
            }
          },
          "required": [
            "name",
            "type"
          ],
          "type": "object"
        },
        {
          "description": "A system source (`source = system:<id>`).",
          "properties": {
            "id": {
              "default": "",
              "type": "string"
            },
            "type": {
              "enum": [
                "system"
              ],
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "Touching": {
      "properties": {
        "kind": {
          "description": "`path | object | artifact`.",
          "type": "string"
        },
        "mode": {
          "default": "write",
          "description": "`read | write`.",
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "since_ms": {
          "default": 0,
          "format": "uint64",
          "minimum": 0.0,
          "type": "integer"
        }
      },
      "required": [
        "kind",
        "ref"
      ],
      "type": "object"
    }
  },
  "description": "`type = \"control\"` payload: session control, executed by the runner. Never enters the LLM context and produces no input receipt.",
  "oneOf": [
    {
      "properties": {
        "command": {
          "enum": [
            "stop"
          ],
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "The only input a finished session still accepts.",
      "properties": {
        "by": {
          "default": "",
          "type": "string"
        },
        "command": {
          "enum": [
            "decide"
          ],
          "type": "string"
        },
        "decision": {
          "description": "`accept | discard`.",
          "type": "string"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "command",
        "decision"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "enum": [
            "subscribe"
          ],
          "type": "string"
        },
        "subscription": {
          "$ref": "#/definitions/Subscription"
        }
      },
      "required": [
        "command",
        "subscription"
      ],
      "type": "object"
    },
    {
      "properties": {
        "command": {
          "enum": [
            "unsubscribe"
          ],
          "type": "string"
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "command",
        "id"
      ],
      "type": "object"
    },
    {
      "description": "Activity declaration (e.g. `agent-session activity --touch <ref>`).",
      "properties": {
        "clear": {
          "default": false,
          "type": "boolean"
        },
        "command": {
          "enum": [
            "activity"
          ],
          "type": "string"
        },
        "summary": {
          "type": [
            "string",
            "null"
          ]
        },
        "touch": {
          "items": {
            "$ref": "#/definitions/Touching"
          },
          "type": "array"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    },
    {
      "description": "A perception record of this session (the former `perception` input).",
      "properties": {
        "command": {
          "enum": [
            "perceive"
          ],
          "type": "string"
        },
        "kind": {
          "default": "observation",
          "type": "string"
        },
        "objects": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "summary": {
          "default": "",
          "type": "string"
        },
        "tags": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "command"
      ],
      "type": "object"
    }
  ],
  "title": "ControlCommand"
}