{
  "layout": { "algorithm": "stack", "direction": "column", "spacing": "{{config.gap}}", "padding": 12 },
  "slots": {
    "header": { "max": 1, "accepts": ["richtext", "shape"], "placement": "top", "title": "Header" },
    "cards": { "accepts": ["cell:did:bns:alice#hello-card", "richtext"], "min": 0, "placement": "stack", "title": "Cards" }
  },
  "chrome": {
    "background": "{{config.background}}",
    "radius": 12,
    "title": { "text": "{{config.title}}", "slot": "header" },
    "empty": "Drop task cards here"
  }
}
