{
  "manifest_version": 2,
  "ident": { "author_did": "did:bns:alice", "name": "hello-board" },
  "kind": "composite",
  "title": "Hello Board",
  "description": "A titled panel that stacks task cards. The cards are real Blocks (hello-card instances or notes); the board owns their layout and the frame around them.",
  "default_size": { "w": 320, "h": 420 },
  "config_schema": {
    "type": "object",
    "properties": {
      "title": { "type": "string", "title": "Board title", "default": "Today" },
      "background": { "type": "string", "title": "Background", "default": "#f6f7fb" },
      "gap": { "type": "integer", "title": "Gap (px)", "default": 8, "minimum": 0, "maximum": 64 }
    }
  },
  "bindings": {},
  "entry": "composition.json",
  "deps": ["did:bns:alice#hello-card"],
  "catalog": { "group": "hello", "description": "A panel of task cards" },
  "agent": "AGENT.md"
}
