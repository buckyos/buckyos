{
  "schema_version": "0.2.0",
  "id": "wf-dv-semantic-skill-review",
  "name": "DV Semantic Skill Review",
  "trigger": {
    "type": "manual"
  },
  "steps": [
    {
      "id": "caption",
      "name": "Caption",
      "type": "autonomous",
      "executor": "service::aicc.vision.caption",
      "idempotent": true,
      "input": {
        "exact_model": "route:vision.caption",
        "image": {
          "kind": "url",
          "url": "https://www.gstatic.com/webp/gallery/1.jpg",
          "mime_hint": "image/jpeg"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "captions": {
            "type": "array"
          },
          "usage": {
            "type": "object"
          }
        },
        "required": [
          "captions"
        ]
      }
    },
    {
      "id": "semantic_review",
      "name": "Semantic Review",
      "type": "autonomous",
      "executor": "/skill/image-quality-review",
      "idempotent": true,
      "input": {
        "caption": "${caption.output.captions}",
        "policy": "product_listing"
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "caption",
      "to": "semantic_review"
    },
    {
      "from": "semantic_review"
    }
  ]
}
