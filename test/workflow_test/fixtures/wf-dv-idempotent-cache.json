{
  "schema_version": "0.2.0",
  "id": "wf-dv-idempotent-cache",
  "name": "DV Idempotent Cache",
  "trigger": {
    "type": "manual"
  },
  "steps": [
    {
      "id": "caption",
      "name": "Caption",
      "type": "autonomous",
      "executor": "service::aicc.vision.caption",
      "idempotent": true,
      "input": {
        "exact_model": "route:vision.caption",
        "image": {
          "kind": "url",
          "url": "https://www.gstatic.com/webp/gallery/1.jpg",
          "mime_hint": "image/jpeg"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "captions": {
            "type": "array"
          },
          "usage": {
            "type": "object"
          }
        },
        "required": [
          "captions"
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "caption"
    }
  ]
}
