{
  "schema_version": "0.2.0",
  "id": "wf-dv-failure-human-retry",
  "name": "DV Failure Human Retry",
  "trigger": {
    "type": "manual"
  },
  "steps": [
    {
      "id": "caption_bad",
      "name": "Caption Bad URL",
      "type": "autonomous",
      "executor": "service::aicc.vision.caption",
      "idempotent": true,
      "skippable": false,
      "input": {
        "exact_model": "route:vision.caption",
        "image": {
          "kind": "url",
          "url": "https://test.buckyos.io/dv/not-found-on-purpose.jpg",
          "mime_hint": "image/jpeg"
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "captions": {
            "type": "array"
          },
          "text": {
            "type": "string"
          }
        }
      },
      "guards": {
        "retry": {
          "max_attempts": 2,
          "fallback": "human"
        }
      }
    },
    {
      "id": "echo_caption",
      "name": "Echo Caption",
      "type": "autonomous",
      "executor": "service::aicc.helper.llm_chat",
      "idempotent": true,
      "input": {
        "logical_model": "llm.chat",
        "messages": [
          {
            "role": "system",
            "content": [
              {
                "type": "text",
                "text": "Repeat what the user says."
              }
            ]
          },
          {
            "role": "user",
            "content": [
              {
                "type": "text",
                "text": "${caption_bad.output.text}"
              }
            ]
          }
        ]
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string"
          }
        },
        "required": [
          "text"
        ]
      }
    }
  ],
  "edges": [
    {
      "from": "caption_bad",
      "to": "echo_caption"
    },
    {
      "from": "echo_caption"
    }
  ]
}
