{
  "name": "nfs-server-test",
  "private": true,
  "type": "module",
  "scripts": {
    "smoke": "deno run --allow-net --allow-read --allow-write --allow-env --unsafely-ignore-certificate-errors nfs_server_dv.ts",
    "ndm": "deno run --allow-net --allow-read --allow-write --allow-env --unsafely-ignore-certificate-errors ndm_dv.ts",
    "ndn": "deno run --allow-net --allow-read --allow-write --allow-env --allow-run --allow-sys --unsafely-ignore-certificate-errors ndn_dv.ts",
    "remote-attachment": "node remote_attachment_dv.mjs",
    "group-attachment": "node group_attachment_dv.mjs",
    "attachment-ui": "node attachment_ui_dv.mjs",
    "test": "pnpm run smoke && pnpm run ndm && pnpm run ndn"
  },
  "dependencies": {
    "buckyos": "latest"
  }
}
