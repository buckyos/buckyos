#!/bin/sh
set -eu

TOOL_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
SDK_DIR="$TOOL_DIR/../../apps/sys_test/node_modules/buckyos"
CONFIG_DIR=${BUCKYOS_TOOL_CONFIG_DIR:-${HOME:-${USERPROFILE:-.}}/.buckyos_tool}
BUCKYOS_RUNTIME_ROOT=${BUCKYOS_ROOT:-/opt/buckyos}
READ_PATHS="$TOOL_DIR,$SDK_DIR,$CONFIG_DIR,$BUCKYOS_RUNTIME_ROOT"
WRITE_PATHS="$CONFIG_DIR"
EXPECT_PATH=""
PIKG_COMMAND=0
EXPECT_GLOBAL_VALUE=0
MODULE_FOUND=0
MODULE_NAME=""
VERB_NAME=""

if [ -n "${BUCKYOS_IDENTITY_ROOT:-}" ]; then
  READ_PATHS="$READ_PATHS,$BUCKYOS_IDENTITY_ROOT"
fi
if [ -n "${BUCKYOS_SECURITY_ROOT:-}" ]; then
  READ_PATHS="$READ_PATHS,$BUCKYOS_SECURITY_ROOT"
fi

for ARGUMENT in "$@"; do
  if [ "$MODULE_FOUND" -eq 1 ]; then
    if [ -z "$VERB_NAME" ]; then
      VERB_NAME=$ARGUMENT
    fi
    continue
  fi
  if [ "$EXPECT_GLOBAL_VALUE" -eq 1 ]; then
    EXPECT_GLOBAL_VALUE=0
    continue
  fi
  case "$ARGUMENT" in
    --config-dir|--profile|--zone|--endpoint|--identity|--identity-root|--security-root|--session-token|--session-token-file|--output|--input|--timeout|--trace-id|--idempotency-key)
      EXPECT_GLOBAL_VALUE=1
      ;;
    --*)
      ;;
    *)
      MODULE_FOUND=1
      MODULE_NAME=$ARGUMENT
      if [ "$ARGUMENT" = "pikg" ]; then
        PIKG_COMMAND=1
      fi
      ;;
  esac
done

COMMAND_STAGE=0
EXPECT_VALUE=0
APP_SOURCE_ADDED=0
for ARGUMENT in "$@"; do
  if [ -n "$EXPECT_PATH" ]; then
    case "$EXPECT_PATH" in
      config)
        CONFIG_DIR=$ARGUMENT
        READ_PATHS="$READ_PATHS,$ARGUMENT"
        WRITE_PATHS="$WRITE_PATHS,$ARGUMENT"
        ;;
      read)
        if [ "$ARGUMENT" != "-" ]; then
          READ_PATHS="$READ_PATHS,$ARGUMENT"
        fi
        ;;
      plan)
        READ_PATHS="$READ_PATHS,$ARGUMENT"
        if [ "$MODULE_NAME" = "app" ] && [ "$VERB_NAME" = "fetch" ]; then
          WRITE_PATHS="$WRITE_PATHS,$ARGUMENT"
        fi
        ;;
      write)
        WRITE_PATHS="$WRITE_PATHS,$ARGUMENT"
        ;;
    esac
    EXPECT_PATH=""
    continue
  fi
  if [ "$EXPECT_VALUE" -eq 1 ]; then
    EXPECT_VALUE=0
    continue
  fi
  if [ "$COMMAND_STAGE" -eq 0 ]; then
    case "$ARGUMENT" in
      --config-dir)
        EXPECT_PATH=config
        continue
        ;;
      --input|--session-token-file|--identity-root|--security-root)
        EXPECT_PATH=read
        continue
        ;;
      --config-dir=*)
        CONFIG_DIR=${ARGUMENT#--config-dir=}
        READ_PATHS="$READ_PATHS,$CONFIG_DIR"
        WRITE_PATHS="$WRITE_PATHS,$CONFIG_DIR"
        continue
        ;;
      --input=*|--session-token-file=*|--identity-root=*|--security-root=*)
        PATH_VALUE=${ARGUMENT#*=}
        if [ "$PATH_VALUE" != "-" ]; then
          READ_PATHS="$READ_PATHS,$PATH_VALUE"
        fi
        continue
        ;;
      --profile|--zone|--endpoint|--identity|--session-token|--output|--timeout|--trace-id|--idempotency-key)
        EXPECT_VALUE=1
        continue
        ;;
      --*)
        continue
        ;;
      *)
        COMMAND_STAGE=1
        continue
        ;;
    esac
  fi
  if [ "$COMMAND_STAGE" -eq 1 ]; then
    COMMAND_STAGE=2
    continue
  fi
  case "$ARGUMENT" in
    --config-dir)
      EXPECT_PATH=config
      ;;
    --config-dir=*)
      CONFIG_DIR=${ARGUMENT#--config-dir=}
      READ_PATHS="$READ_PATHS,$CONFIG_DIR"
      ;;
    --input|--session-token-file|--identity-root|--security-root|--pikg)
      EXPECT_PATH=read
      ;;
    --file)
      if [ "$MODULE_NAME" = "system-config" ] && [ "$VERB_NAME" = "set-file" ]; then
        EXPECT_PATH=read
      else
        EXPECT_VALUE=1
      fi
      ;;
    --plan)
      EXPECT_PATH=plan
      ;;
    --path)
      EXPECT_PATH=write
      ;;
    --input=*|--session-token-file=*|--identity-root=*|--security-root=*|--pikg=*)
      PATH_VALUE=${ARGUMENT#*=}
      if [ "$PATH_VALUE" != "-" ]; then
        READ_PATHS="$READ_PATHS,$PATH_VALUE"
      fi
      ;;
    --file=*)
      if [ "$MODULE_NAME" = "system-config" ] && [ "$VERB_NAME" = "set-file" ]; then
        PATH_VALUE=${ARGUMENT#*=}
        READ_PATHS="$READ_PATHS,$PATH_VALUE"
      fi
      ;;
    --plan=*)
      PATH_VALUE=${ARGUMENT#*=}
      READ_PATHS="$READ_PATHS,$PATH_VALUE"
      if [ "$MODULE_NAME" = "app" ] && [ "$VERB_NAME" = "fetch" ]; then
        WRITE_PATHS="$WRITE_PATHS,$PATH_VALUE"
      fi
      ;;
    --path=*)
      PATH_VALUE=${ARGUMENT#*=}
      WRITE_PATHS="$WRITE_PATHS,$PATH_VALUE"
      ;;
    --from|--app-class|--owner|--policy|--data|--strategy)
      EXPECT_VALUE=1
      ;;
    --*)
      ;;
    *)
      if [ "$MODULE_NAME" = "app" ] && { [ "$VERB_NAME" = "fetch" ] || [ "$VERB_NAME" = "install" ]; } && [ "$APP_SOURCE_ADDED" -eq 0 ]; then
        APP_SOURCE_ADDED=1
        case "$ARGUMENT" in
          http://*|https://*)
            ;;
          *)
            READ_PATHS="$READ_PATHS,$ARGUMENT"
            ;;
        esac
      fi
      ;;
  esac
done

ENV_NAMES="HOME,USERPROFILE,APPDATA,BUCKYOS_TOOL_CONFIG_DIR,BUCKYOS_TOOL_PROFILE,BUCKYOS_TOOL_ZONE,BUCKYOS_TOOL_ENDPOINT,BUCKYOS_TOOL_IDENTITY,BUCKYOS_TOOL_OUTPUT,BUCKYOS_IDENTITY_ROOT,BUCKYOS_SECURITY_ROOT,BUCKYOS_APPCLIENT_SESSION_TOKEN,BUCKYOS_ROOT"

if [ "$PIKG_COMMAND" -eq 1 ]; then
  exec deno run --quiet --allow-read --allow-write --allow-run=docker --allow-env="$ENV_NAMES" "$TOOL_DIR/main.ts" "$@"
fi

exec deno run --quiet --allow-net --allow-read="$READ_PATHS" --allow-write="$WRITE_PATHS" --allow-env="$ENV_NAMES" "$TOOL_DIR/main.ts" "$@"
