{
  "nodes": {
    "klogood1": {
      "node_id": "klogood1",
      "vm_template": "ubuntu_basic",
      "vm_params": {
        "cpu": 1,
        "memory": "2G",
        "disk": "30G"
      },
      "network": {
        "lan_id": "lan",
        "type": "nat"
      },
      "apps": {
        "buckyos_dev": {
          "node_group": "klog_3ood.ood1"
        }
      },
      "init_commands": [
        "sudo hostnamectl set-hostname klogood1",
        "sudo mkdir -p /opt/buckyos",
        "sudo chown -R ubuntu:ubuntu /opt/buckyos"
      ],
      "instance_commands": [
        "sudo sh -c \"grep -q 'ood1.klog3ood.local' /etc/hosts || echo '{{klogood1.ip}} ood1.klog3ood.local' >> /etc/hosts\"",
        "sudo sh -c \"grep -q 'ood2.klog3ood.local' /etc/hosts || echo '{{klogood2.ip}} ood2.klog3ood.local' >> /etc/hosts\"",
        "sudo sh -c \"grep -q 'ood3.klog3ood.local' /etc/hosts || echo '{{klogood3.ip}} ood3.klog3ood.local' >> /etc/hosts\""
      ],
      "directories": {
        "logs": "/opt/buckyos/logs"
      }
    },
