@echo off
setlocal
set "ROOT=%~dp0.."
set "TOOL=%ROOT%\libexec\buckyos-tool"
set "DENO=%TOOL%\runtime\deno.exe"
if not defined BUCKYOS_ROOT set "BUCKYOS_ROOT=%ROOT%"
"%DENO%" run --no-prompt --allow-read="%TOOL%" --allow-env="HOME,USERPROFILE,APPDATA,BUCKYOS_TOOL_CONFIG_DIR,BUCKYOS_TOOL_PROFILE,BUCKYOS_TOOL_ZONE,BUCKYOS_TOOL_ENDPOINT,BUCKYOS_TOOL_IDENTITY,BUCKYOS_TOOL_OUTPUT,BUCKYOS_IDENTITY_ROOT,BUCKYOS_SECURITY_ROOT,BUCKYOS_APPCLIENT_SESSION_TOKEN,BUCKYOS_ROOT,SOURCE_DATE_EPOCH" --allow-run="%DENO%" "%TOOL%\cli\system_bootstrap.ts" %*
