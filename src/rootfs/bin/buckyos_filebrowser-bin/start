#!/usr/bin/python3
# TODO : 现在非docker版的filebrowser不会使用了(filebrowser变成了纯example)
import os
import sys
import json
current_dir = os.path.dirname(os.path.abspath(__file__))
sys.path.append(current_dir)
import util

# os.system(f"python3 {start_script} {appid} {username}")
# 命令行参数类似标准的system service, 主要通过环境变量来传递复杂参数
# 本脚本将读取buckeyes的环境变量转化为filebrowser支持的命令行参数
# filebrowser -r /path/to/your/files -d /var/lib/filebrowser/filebrowser.db -c /etc/filebrowser/config.json -p 8080 -a 0.0.0.0

appid = None
app_instance_id = None
owner_userid = None
app_token = None
app_instance_config = None

def get_app_bin_path(appid):
    bin_path = os.path.join(current_dir, appid)
    if util.ext:
        bin_path += util.ext
    return bin_path

def load_app_instance_cfg():
    global appid, app_instance_id, owner_userid, app_token, app_instance_config
    appid = os.getenv("BUCKYOS_APP_ID")
    app_instance_id = os.getenv("BUCKYOS_APP_INSTANCE_ID")
    owner_userid = os.getenv("BUCKYOS_OWNER_USER_ID")
    app_token = os.getenv("BUCKYOS_APP_TOKEN")
    app_instance_config_str = os.getenv("app_instance_config")
    if not appid or not app_instance_id or not owner_userid:
        print("Incomplete BuckyOS app identity environment")
        exit(1)
    if app_instance_id != f"{appid}@{owner_userid}":
        print("Inconsistent BuckyOS app identity environment")
        exit(1)
    if not app_token:
        print(f"No session token found for app: {app_instance_id}")
        exit(1)
    if not app_instance_config_str:
        print(f"No configuration found for app: {app_instance_id}")
        exit(1)
    app_instance_config = json.loads(app_instance_config_str)
    return app_instance_config

def start_app(instance_cfg):
    service_ports = instance_cfg.get("service_ports_config", {})
    will_use_port = service_ports.get("www")
    if will_use_port is None and service_ports:
        will_use_port = next(iter(service_ports.values()))
    if will_use_port is None:
        print(f"No service port found for app: {app_instance_id}")
        exit(1)

    base_dir = util.get_user_data_dir(owner_userid)
    execution_spec = instance_cfg.get("node_execution_spec", {})
    service_spec = execution_spec.get("service_spec_config", {})
    data_mount_point = service_spec.get("data_mount_point", {})

    def mount_dir(container_path, default_dir):
        mount = data_mount_point.get(container_path) or data_mount_point.get(f"{container_path}/")
        if not mount:
            return default_dir
        target_path = mount.get("target_path") if isinstance(mount, dict) else mount
        return os.path.join(base_dir, str(target_path).lstrip("/"))

    app_data_dir = os.getenv("BUCKYOS_DATA_DIR") or util.get_app_data_dir(appid, owner_userid)
    data_dir = mount_dir("/srv", os.path.join(app_data_dir, "srv"))
    util.ensure_directory_accessible(data_dir)

    config_dir = mount_dir("/config", os.path.join(app_data_dir, "config"))
    util.ensure_directory_accessible(config_dir)

    db_dir = mount_dir("/database", os.path.join(app_data_dir, "database"))
    util.ensure_directory_accessible(db_dir)

    bin_path = get_app_bin_path("filebrowser")
    params = f"-r {data_dir} -c {config_dir}/config.json -d {db_dir}/filebrowser.db -p {will_use_port} -a 127.0.0.1"
    cmd = f"{bin_path} {params}"
    util.nohup_start(cmd, env_vars=None)

def try_stop_app(cfg):
    util.kill_process("filebrowser")

if __name__ == "__main__":
    bin_path = get_app_bin_path("filebrowser")
    instance_cfg = load_app_instance_cfg()
    try_stop_app(instance_cfg)
    start_app(instance_cfg)
