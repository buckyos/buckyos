# save to ~/.buckycli/buckyos_boot.toml
# YOUR_TG_AccountId is look like user:xxxx

"services/msg-center/settings" = """
{
    "telegram_tunnel": {
        "tunnel_did":"did:web:tg-tunnel.test.buckyos.io",
        "enabled": true,
        "gateway": {
            "mode": "bot_api"
        },
        "bindings": [
            {
                "owner_did": "did:web:jarvis.test.buckyos.io",
                "bot_token": "$YOUR_BOT_TOKEN$",
                "bot_account_id": "$ YOUR_BOT_ACCOUNT_ID"
            }
        ]
    }
}
"""

"users/devtest/profile" = """
{
  "did": "did:bns:devtest",
  "name": "devtest",
  "display_name": "$YOUR NAME",
  "private_extra": {
    "system_contact": {
      "did": "did:bns:devtest",
      "groups": ["zone_user"],
      "bindings": [
        {
          "platform": "telegram",
          "account_id": "$YOUR_TG_AccountId$",
          "display_id": "$YOUR_TG_AccountName$",
          "tunnel_id": "did:web:tg-tunnel.test.buckyos.io"
        }
      ]
    }
  }
}
"""

"services/aicc/settings" = """
{
    "providers": [
        {
            "provider_instance_name": "openai-default",
            "provider_type": "cloud_api",
            "provider_profile_id": "openai",
            "protocol_adapter_id": "openai-responses",
            "provider_rules_id": "openai",
            "base_url": "https://api.openai.com/v1",
            "credentials": {
                "api_token": {
                    "locked": "$OPEN_AI_API_TOKEN$"
                }
            },
            "enabled": true,
            "timeout_ms": 600000,
            "auto_sync_models": true
        }
    ]
}
"""

"users/devtest/settings" = """
{
  "user_id": "devtest",
  "type": "user",
  "password": "o8XyToejrbCYou84h/VkF4Tht0BeQQbuX3XKG+8+GQ4=",
  "state": "active",
  "res_pool_id": "default",
  "is_local": true
}
"""
