  "version_rules": [
    {
      "id": "gpt-standard",
      "family": "gpt",
      "tier": "standard",
      "match": "gpt-*",
      "exclude_tier_tokens": ["pro", "mini", "nano", "sol", "terra", "luna", "codex"],
      "version_rank": { "prefix": "gpt" },
      "stability": { "unstable_tokens": ["preview", "beta", "experimental"], "current_requires_stable": true },
      "current_mount": "llm.gpt-standard",
      "version_mount": "llm.openai.{model}",
      "auto_mounts": ["llm.gpt", "llm.gpt-standard", "llm.gpt-pro", "llm.gpt-mini", "llm.gpt-nano", "llm", "llm.summarize", "llm.swift", "llm.plan", "llm.reason", "llm.code"]
