  "variants": [
    { "name": "reasoning-none", "match": { "origin_model_id": ["gpt-5.6*", "gpt-5.5", "gpt-5.5-20*", "gpt-5.4", "gpt-5.4-20*", "gpt-5.4-mini*", "gpt-5.4-nano*"] }, "mount_suffix": "reasoning-none" },
    { "name": "reasoning-low", "match": { "origin_model_id": ["gpt-5.6*", "gpt-5.5", "gpt-5.5-20*", "gpt-5.4", "gpt-5.4-20*", "gpt-5.4-mini*", "gpt-5.4-nano*", "gpt-5.3-codex*"] }, "mount_suffix": "reasoning-low" },
