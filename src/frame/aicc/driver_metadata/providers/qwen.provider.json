{
  "format": "buckyos.aicc.provider-rules-catalog",
  "schema_version": 1,
  "schema_revision": 0,
  "revision_seq": 2,
  "provider_profile_id": "qwen",
  "metadata_drivers": ["qwen"],
  "origin_provider_aliases": {},
  "origin_mappings": [],
  "models": [],
  "patterns": [
    {
      "match": "qwen-image*",
      "operations": { "image.txt2img": "dashscope.image_synthesis", "image.img2img": "dashscope.image_edit" }
    },
    {
      "match": "wan*-t2i*",
      "operations": { "image.txt2img": "dashscope.image_synthesis" }
    },
    {
      "match": "wan*-i2v*",
      "operations": { "video.img2video": "dashscope.video_synthesis" }
    },
    {
      "match": "wan*-t2v*",
      "operations": { "video.txt2video": "dashscope.video_synthesis" }
    },
    {
      "match": "*",
      "operations": { "llm": "responses.create" },
      "request_rules": [
        {
          "remove": [
            "/background",
            "/include",
            "/metadata",
            "/parallel_tool_calls",
            "/service_tier",
            "/truncation",
            "/seed",
            "/stop"
          ]
        }
      ]
    }
  ],
  "variants": [
    {
      "model_driver": "qwen",
      "variant": "reasoning-none",
      "match": { "provider_model_id": "qwen3*", "variant": "reasoning-none" },
      "provider_options": { "reasoning": { "effort": "none" } }
    },
    {
      "model_driver": "qwen",
      "variant": "reasoning-mini",
      "match": { "provider_model_id": "qwen3*", "variant": "reasoning-mini" },
      "provider_options": { "reasoning": { "effort": "minimal" } }
    },
    {
      "model_driver": "qwen",
      "variant": "reasoning-low",
      "match": { "provider_model_id": "qwen3*", "variant": "reasoning-low" },
      "provider_options": { "reasoning": { "effort": "low" } }
    },
    {
      "model_driver": "qwen",
      "variant": "reasoning-medium",
      "match": { "provider_model_id": "qwen3*", "variant": "reasoning-medium" },
      "provider_options": { "reasoning": { "effort": "medium" } }
    },
    {
      "model_driver": "qwen",
      "variant": "reasoning-high",
      "match": { "provider_model_id": "qwen3*", "variant": "reasoning-high" },
      "provider_options": { "reasoning": { "effort": "high" } }
    },
    {
      "model_driver": "qwen",
      "variant": "reasoning-xhigh",
      "match": { "provider_model_id": "qwen3*", "variant": "reasoning-xhigh" },
      "provider_options": { "reasoning": { "effort": "xhigh" } }
    },
    {
      "model_driver": "qwen",
      "variant": "reasoning-max",
      "match": { "provider_model_id": "qwen3*", "variant": "reasoning-max" },
      "provider_options": { "reasoning": { "effort": "max" } }
    }
  ]
}
