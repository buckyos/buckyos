{
  "format": "buckyos.aicc.provider-rules-catalog",
  "schema_version": 1,
  "schema_revision": 1,
  "revision_seq": 2,
  "provider_profile_id": "glm",
  "metadata_drivers": ["glm"],
  "static_inventory_models": [
    "glm-image",
    "cogview-4-250304",
    "cogview-4",
    "cogview-3-flash",
    "glm-asr-2512",
    "glm-tts",
    "embedding-3",
    "embedding-2",
    "cogvideox-3",
    "cogvideox-flash",
    "viduq1-text",
    "viduq1-image",
    "viduq1-start-end",
    "vidu2-image",
    "vidu2-start-end",
    "vidu2-reference"
  ],
  "models": [
    { "id": "glm-image", "operations": { "image.txt2img": "images.generate" } },
    { "id": "cogview-4-250304", "operations": { "image.txt2img": "images.generate" } },
    { "id": "cogview-4", "operations": { "image.txt2img": "images.generate" } },
    { "id": "cogview-3-flash", "operations": { "image.txt2img": "images.generate" } },
    { "id": "glm-asr-2512", "operations": { "audio.asr": "audio.transcriptions" } },
    {
      "id": "glm-tts",
      "operations": { "audio.tts": "audio.speech" },
      "canonical_fields": {
        "/voice": {
          "converter": "glm_tts_voice_v1",
          "fallback": { "action": "default", "value": {} }
        }
      }
    },
    { "id": "embedding-3", "operations": { "embedding.text": "embeddings.create" } },
    { "id": "embedding-2", "operations": { "embedding.text": "embeddings.create" } },
    { "id": "cogvideox-3", "operations": { "video.txt2video": "videos.generate", "video.img2video": "videos.generate" } },
    { "id": "cogvideox-flash", "operations": { "video.txt2video": "videos.generate", "video.img2video": "videos.generate" } },
    { "id": "viduq1-text", "operations": { "video.txt2video": "videos.generate" } },
    { "id": "viduq1-image", "operations": { "video.img2video": "videos.generate" } },
    { "id": "viduq1-start-end", "operations": { "video.img2video": "videos.generate" } },
    { "id": "vidu2-image", "operations": { "video.img2video": "videos.generate" } },
    { "id": "vidu2-start-end", "operations": { "video.img2video": "videos.generate" } },
    { "id": "vidu2-reference", "operations": { "video.img2video": "videos.generate" } }
  ],
  "patterns": [
    {
      "match": "*",
      "operations": { "llm": "chat.completions.create", "vision.ocr": "chat.completions.create", "vision.caption": "chat.completions.create" }
    }
  ],
  "variants": [
    { "model_driver": "glm", "variant": "thinking-enabled", "match": { "provider_model_id": ["glm-5*", "glm-4.7*", "glm-4.6*", "glm-4.5*"], "variant": "thinking-enabled" }, "provider_options": { "thinking": { "type": "enabled" } } },
    { "model_driver": "glm", "variant": "thinking-disabled", "match": { "provider_model_id": ["glm-5*", "glm-4.7*", "glm-4.6*", "glm-4.5*"], "variant": "thinking-disabled" }, "provider_options": { "thinking": { "type": "disabled" } } }
  ]
}
