{
  "format": "buckyos.aicc.provider-rules-catalog",
  "schema_version": 1,
  "schema_revision": 0,
  "revision_seq": 1,
  "provider_profile_id": "openrouter",
  "origin_provider_aliases": {
    "anthropic": "claude",
    "google": "gemini",
    "moonshotai": "kimi",
    "z-ai": "glm"
  },
  "origin_mappings": [
    {
      "extract": {
        "source": "provider_model_id",
        "regex": "^(?<driver>[^/]+)/(?<model>.+)$"
      },
      "transforms": {
        "driver": [
          { "op": "lowercase" },
          { "op": "alias", "table": "origin_provider_aliases", "on_missing": "keep" }
        ],
        "model": [{ "op": "trim" }]
      }
    }
  ],
  "patterns": [
    {
      "match": "cohere/rerank-*",
      "operations": { "rerank": "rerank.create" }
    },
    {
      "match": "*",
      "operations": { "llm": "chat.completions.create" }
    }
  ],
  "variants": [
    { "model_driver": "openai", "variant": "reasoning-none", "match": { "provider_model_id": "openai/gpt-5.6*", "variant": "reasoning-none" }, "provider_options": { "reasoning_effort": "none" } },
    { "model_driver": "openai", "variant": "reasoning-low", "match": { "provider_model_id": "openai/gpt-5.6*", "variant": "reasoning-low" }, "provider_options": { "reasoning_effort": "low" } },
    { "model_driver": "openai", "variant": "reasoning-medium", "match": { "provider_model_id": "openai/gpt-5.6*", "variant": "reasoning-medium" }, "provider_options": { "reasoning_effort": "medium" } },
    { "model_driver": "openai", "variant": "reasoning-high", "match": { "provider_model_id": "openai/gpt-5.6*", "variant": "reasoning-high" }, "provider_options": { "reasoning_effort": "high" } },
    { "model_driver": "openai", "variant": "reasoning-xhigh", "match": { "provider_model_id": "openai/gpt-5.6*", "variant": "reasoning-xhigh" }, "provider_options": { "reasoning_effort": "xhigh" } },
    { "model_driver": "openai", "variant": "reasoning-max", "match": { "provider_model_id": "openai/gpt-5.6*", "variant": "reasoning-max" }, "provider_options": { "reasoning_effort": "max" } }
  ]
}
