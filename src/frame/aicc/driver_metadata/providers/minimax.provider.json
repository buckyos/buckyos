{
  "format": "buckyos.aicc.provider-rules-catalog",
  "schema_version": 1,
  "schema_revision": 0,
  "revision_seq": 1,
  "provider_profile_id": "minimax",
  "metadata_drivers": ["minimax"],
  "models": [
    {
      "id": "speech-2.8-hd",
      "operations": { "audio.tts": "t2a.create" }
    },
    {
      "id": "image-01",
      "operations": { "image.txt2img": "image_generation.create", "image.img2img": "image_generation.create" }
    },
    {
      "id": "MiniMax-Hailuo-02",
      "operations": { "video.txt2video": "video_generation.create", "video.img2video": "video_generation.create" }
    },
    {
      "id": "music-2.0",
      "operations": { "audio.music": "music_generation.create" }
    }
  ],
  "patterns": [
    {
      "match": "MiniMax-M2*",
      "operations": { "llm": "messages.create" },
      "request_rules": [
        {
          "defaults": { "temperature": 1.0, "top_p": 0.9 },
          "remove": ["/stop"]
        }
      ]
    },
    {
      "match": "speech-*",
      "operations": { "audio.tts": "t2a.create" }
    },
    {
      "match": "image-*",
      "operations": { "image.txt2img": "image_generation.create", "image.img2img": "image_generation.create" }
    },
    {
      "match": "MiniMax-Hailuo-*",
      "operations": { "video.txt2video": "video_generation.create", "video.img2video": "video_generation.create" }
    },
    {
      "match": "music-*",
      "operations": { "audio.music": "music_generation.create" }
    },
    {
      "match": "*",
      "operations": { "llm": "messages.create" },
      "request_rules": [{ "remove": ["/stop"] }]
    }
  ]
}
