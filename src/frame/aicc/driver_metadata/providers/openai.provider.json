{
  "format": "buckyos.aicc.provider-rules-catalog",
  "schema_version": 1,
  "schema_revision": 1,
  "revision_seq": 2,
  "provider_profile_id": "openai",
  "custom_provider_adapters": ["openai-responses", "openai-chat-completions"],
  "metadata_drivers": ["openai"],
  "origin_provider_aliases": {},
  "origin_mappings": [],
  "models": [
    {
      "id": "gpt-4o-mini-tts",
      "operations": { "audio.tts": "audio.speech" },
      "canonical_fields": {
        "/voice": {
          "converter": "openai_tts_voice_v2",
          "fallback": { "action": "default", "value": {} }
        }
      }
    }
  ],
  "patterns": [
    {
      "match": "gpt-5*",
      "operations": {
        "llm": "responses.create",
        "vision.ocr": "responses.create",
        "vision.caption": "responses.create",
        "image.txt2img": "responses.create",
        "image.img2img": "responses.create",
        "agent.computer_use": "responses.create"
      },
      "request_rules": [
        {
          "when": { "/reasoning/effort": { "not": "none" } },
          "remove": ["/temperature", "/top_p"]
        }
      ]
    },
    {
      "match": "tts-*",
      "operations": { "audio.tts": "audio.speech" },
      "canonical_fields": {
        "/voice": {
          "converter": "openai_tts_voice_v1",
          "fallback": { "action": "default", "value": {} }
        }
      }
    },
    {
      "match": "*",
      "operations": {
        "llm": "responses.create",
        "embedding.text": "embeddings.create",
        "image.txt2img": "images.generate",
        "image.img2img": "images.edit",
        "image.inpaint": "images.edit",
        "audio.tts": "audio.speech",
        "audio.asr": "audio.transcriptions",
        "video.txt2video": "videos.create",
        "video.img2video": "videos.create",
        "video.video2video": "videos.create"
      },
      "request_rules": [
        {
          "when": { "api_type": "video.txt2video", "operation": "videos.create" },
          "canonical_fields": {
            "/duration_seconds": {
              "converter": "openai_video_duration_v1",
              "fallback": { "action": "omit" }
            },
            "/aspect_ratio": {
              "converter": "omit",
              "fallback": { "action": "omit" }
            },
            "/resolution": {
              "converter": "openai_video_resolution_v1",
              "fallback": { "action": "omit" }
            },
            "/output/fps": {
              "converter": "omit",
              "fallback": { "action": "omit" }
            }
          }
        },
        {
          "when": { "api_type": "video.img2video", "operation": "videos.create" },
          "canonical_fields": {
            "/duration_seconds": {
              "converter": "openai_video_duration_v1",
              "fallback": { "action": "omit" }
            },
            "/aspect_ratio": {
              "converter": "omit",
              "fallback": { "action": "omit" }
            },
            "/resolution": {
              "converter": "openai_video_resolution_v1",
              "fallback": { "action": "omit" }
            }
          }
        }
      ]
    }
  ],
  "variants": [
    {
      "model_driver": "openai",
      "variant": "reasoning-none",
      "match": { "provider_model_id": ["gpt-5.6*", "gpt-5.5", "gpt-5.5-20*", "gpt-5.4", "gpt-5.4-20*", "gpt-5.4-mini*", "gpt-5.4-nano*"], "variant": "reasoning-none" },
      "provider_options": { "reasoning": { "effort": "none" } }
    },
    {
      "model_driver": "openai",
      "variant": "reasoning-low",
      "match": { "provider_model_id": ["gpt-5.6*", "gpt-5.5", "gpt-5.5-20*", "gpt-5.4", "gpt-5.4-20*", "gpt-5.4-mini*", "gpt-5.4-nano*", "gpt-5.3-codex*"], "variant": "reasoning-low" },
      "provider_options": { "reasoning": { "effort": "low" } }
    },
    {
      "model_driver": "openai",
      "variant": "reasoning-medium",
      "match": { "provider_model_id": ["gpt-5.6*", "gpt-5.5*", "gpt-5.4*", "gpt-5.3-codex*"], "variant": "reasoning-medium" },
      "provider_options": { "reasoning": { "effort": "medium" } }
    },
    {
      "model_driver": "openai",
      "variant": "reasoning-high",
      "match": { "provider_model_id": ["gpt-5.6*", "gpt-5.5*", "gpt-5.4*", "gpt-5.3-codex*"], "variant": "reasoning-high" },
      "provider_options": { "reasoning": { "effort": "high" } }
    },
    {
      "model_driver": "openai",
      "variant": "reasoning-xhigh",
      "match": { "provider_model_id": ["gpt-5.6*", "gpt-5.5*", "gpt-5.4*", "gpt-5.3-codex*"], "variant": "reasoning-xhigh" },
      "provider_options": { "reasoning": { "effort": "xhigh" } }
    },
    {
      "model_driver": "openai",
      "variant": "reasoning-max",
      "match": { "provider_model_id": "gpt-5.6*", "variant": "reasoning-max" },
      "provider_options": { "reasoning": { "effort": "max" } }
    }
  ]
}
