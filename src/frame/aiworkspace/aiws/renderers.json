    "config": { "x": "横轴字段名（date / text / number）", "y": "数值字段名", "color": "#RRGGBB（可选）" },
    "config_summary": "x=横轴字段名, y=数值字段名" },
  { "renderer": "sample.metric", "title": "指标卡", "accepts": ["buckyos.table-source"],
