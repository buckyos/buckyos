    "config": {} },
  { "renderer": "asset", "title": "图片 / 附件", "accepts": ["buckyos.asset-ref"],
    "description": "显示图片（SVG/PNG/JPEG）或文件",
    "config": {} },
  { "renderer": "sample.bar-chart", "title": "柱状图", "accepts": ["buckyos.table-source"],
