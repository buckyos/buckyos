    "config": { "value": "数值字段名（number / decimal）", "by": "分组字段名", "color": "#RRGGBB（可选）" },
    "config_summary": "value=数值字段名, by=分组字段名" },
  { "renderer": "sample.line-chart", "title": "折线图", "accepts": ["buckyos.table-source"],
