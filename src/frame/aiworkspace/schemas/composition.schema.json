{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "buckyos.ai-workspace/composition/3",
 "title": "composition.json of a composite control (扩展控件 P1 K3; P2 events, P3 grid; 控件机制 manifest 4: projections, media, visible)",
 "description": "Three things only: the layout its children get (an algorithm the host ships: stack or fixed, K2), the slots user content lives in, and the Chrome drawn around them from config (R23). It never creates or deletes user Blocks: they stay real Blocks of the BlockTree, each carrying `slot`. `ext.build` checks it (store/src/ext.rs), the Desktop draws it (ui/controls/composite/); the core keeps only its shape (an object ≤ 64 KiB, ≤ 16 slots). String values may be `{{config.<key>}}` with the key declared in config_schema.properties. `events` (manifest_version 3) re-raises events of the children in a slot; `grid` (P3) fills cells row by row. Manifest 4 (控件机制 TODO G2, G13, G17, G19, G21) adds `projections` (Blocks projected from bound data, never stored), `media` (a slot's media Block plays from an anchor in the config, by the service's clock) and a slot's `visible` (shown to each viewer for a while from their first opening: a presentation, not access control); an event may come from a press on a projected node (`from { projection, role }`).",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "layout",
  "slots"
 ],
 "properties": {
  "layout": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "algorithm"
   ],
   "properties": {
    "algorithm": {
     "enum": [
      "stack",
      "fixed",
      "grid"
     ],
     "description": "stack: the slots' children one after another (column or row); fixed: every child keeps its own x / y (none is \"auto\"); grid: children fill `columns` cells per row in slot order (P3). A host that does not know the algorithm lays the children out as a group and says so."
    },
    "direction": {
     "enum": [
      "column",
      "row"
     ],
     "default": "column",
     "description": "stack only"
    },
    "spacing": {
     "oneOf": [
      {
       "type": "number",
       "minimum": 0,
       "maximum": 2000
      },
      {
       "$ref": "#/$defs/config_ref"
      }
     ],
     "default": 8,
     "description": "gap between stacked children, px"
    },
    "padding": {
     "oneOf": [
      {
       "type": "number",
       "minimum": 0,
       "maximum": 2000
      },
      {
       "type": "object",
       "additionalProperties": false,
       "properties": {
        "t": {
         "type": "number",
         "minimum": 0,
         "maximum": 2000
        },
        "r": {
         "type": "number",
         "minimum": 0,
         "maximum": 2000
        },
        "b": {
         "type": "number",
         "minimum": 0,
         "maximum": 2000
        },
        "l": {
         "type": "number",
         "minimum": 0,
         "maximum": 2000
        }
       }
      }
     ],
     "default": 12,
     "description": "inner margin, px (all sides, or { t, r, b, l })"
    },
    "columns": {
     "type": "integer",
     "minimum": 1,
     "maximum": 12,
     "description": "grid only (required there)"
    },
    "gap": {
     "oneOf": [
      {
       "type": "number",
       "minimum": 0,
       "maximum": 2000
      },
      {
       "$ref": "#/$defs/config_ref"
      }
     ],
     "default": 8,
     "description": "grid only: the space between cells, px"
    }
   }
  },
  "slots": {
   "type": "object",
   "maxProperties": 16,
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]{0,31}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "accepts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
       "type": "string",
       "maxLength": 160,
       "pattern": "^(cell:did:[a-z0-9]+:[^/#\\s]+#[a-z0-9][a-z0-9._-]{0,63}|container|[a-z0-9][a-z0-9._-]{0,63})$"
      },
      "description": "what may fill it: `cell:<ident>` (an instance of that control: in deps or already in this Workspace), a view type (`richtext`, `shape`, `card`, …), or `container` (a group or a control); absent: any Block"
     },
     "min": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64,
      "description": "Blocks the Desktop creates when inserting an instance (empty Cells of the first accepted view)"
     },
     "max": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000,
      "description": "the clients refuse more (the core does not count, Q15)"
     },
     "placement": {
      "enum": [
       "stack",
       "top",
       "bottom",
       "free"
      ],
      "default": "stack",
      "description": "where the slot sits in a stack: before (top) or after (bottom) the stacked slots, in order (stack); free: children keep their x / y (the only placement of a fixed layout)"
     },
     "title": {
      "type": "string",
      "maxLength": 256
     },
     "visible": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "from",
       "for_ms"
      ],
      "properties": {
       "from": {
        "const": "first_open"
       },
       "for_ms": {
        "oneOf": [
         {
          "type": "integer",
          "minimum": 1000,
          "maximum": 31536000000
         },
         {
          "$ref": "#/$defs/config_ref"
         }
        ]
       }
      },
      "description": "manifest_version 4: each viewer sees the slot's Blocks for `for_ms` from their own first opening (user state, the service's clock); design mode, static views, prints and exports show them, marked"
     }
    }
   }
  },
  "chrome": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "background": {
     "type": "string",
     "maxLength": 64,
     "description": "a CSS colour, or {{config.<key>}}"
    },
    "radius": {
     "oneOf": [
      {
       "type": "number",
       "minimum": 0,
       "maximum": 200
      },
      {
       "$ref": "#/$defs/config_ref"
      }
     ]
    },
    "border": {
     "type": "string",
     "maxLength": 64,
     "description": "a CSS colour, or {{config.<key>}}"
    },
    "title": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "text"
     ],
     "properties": {
      "text": {
       "type": "string",
       "maxLength": 256,
       "description": "text, may hold {{config.<key>}}"
      },
      "slot": {
       "type": "string",
       "pattern": "^[a-z][a-z0-9_]{0,31}$",
       "description": "draw the title only while this slot is empty"
      }
     }
    },
    "empty": {
     "type": "string",
     "maxLength": 1000,
     "description": "what an empty instance shows, may hold {{config.<key>}}"
    }
   }
  },
  "events": {
   "type": "object",
   "maxProperties": 16,
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]{0,31}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
     "title": {
      "type": "string",
      "maxLength": 256
     },
     "description": {
      "type": "string",
      "maxLength": 4000
     },
     "from": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
       "slot": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
       },
       "event": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
       },
       "projection": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
       },
       "role": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
       }
      },
      "description": "{ slot, event }: a child's event re-raised; { projection, role? } (manifest_version 4): a press on a projected node of that role (default body) in run mode, with params { item, projection }"
     }
    },
    "required": [
     "from"
    ]
   },
   "description": "Events of the composite (manifest_version 3, Q26): each re-raises the event `from.event` of a child in `from.slot`; the slot must accept at least one cell:<ident> whose definition declares it (EVENT_UNDECLARED). An instance binds handlers in its `on`."
  },
  "projections": {
   "type": "object",
   "maxProperties": 8,
   "propertyNames": {
    "pattern": "^[a-z][a-z0-9_]{0,31}$"
   },
   "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": [
     "source",
     "template",
     "layout"
    ],
    "properties": {
     "source": {
      "oneOf": [
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "binding"
        ],
        "properties": {
         "kind": {
          "const": "records"
         },
         "binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
         },
         "sort": {
          "type": "string",
          "maxLength": 64
         },
         "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
         }
        }
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "binding"
        ],
        "properties": {
         "kind": {
          "const": "members"
         },
         "binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
         },
         "accept": {
          "enum": [
           "image",
           "audio",
           "video",
           "any"
          ]
         }
        }
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind",
         "binding",
         "field"
        ],
        "properties": {
         "kind": {
          "const": "counts"
         },
         "binding": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
         },
         "field": {
          "type": "string",
          "maxLength": 64
         },
         "top": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
         },
         "of": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,31}$"
         }
        }
       },
       {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "kind"
        ],
        "properties": {
         "kind": {
          "const": "viewer"
         }
        }
       }
      ],
      "description": "records of a bound table; members of a bound directory (name, object_id, media_type, size); the elements of a list field counted, most first (key, count, rank; a select's elements by option label; `of` joins another projection's items by key); the viewer (principal, first_open, remaining_ms)"
     },
     "mark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "binding",
       "field",
       "as"
      ],
      "properties": {
       "binding": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
       },
       "field": {
        "type": "string",
        "maxLength": 64
       },
       "as": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,31}$"
       }
      },
      "description": "item.<as> is true when the viewer's own record (the submitter's) of the table lists the item's key in field"
     },
     "template": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "nodes"
      ],
      "properties": {
       "nodes": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {
         "type": "object",
         "additionalProperties": false,
         "required": [
          "id",
          "view"
         ],
         "properties": {
          "id": {
           "type": "string",
           "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "view": {
           "enum": [
            "label",
            "shape",
            "asset"
           ]
          },
          "box": {
           "type": "object",
           "additionalProperties": false,
           "properties": {
            "x": {
             "oneOf": [
              {
               "type": "number",
               "minimum": 0,
               "maximum": 4000
              },
              {
               "type": "string",
               "maxLength": 128,
               "description": "`{{item.<k>}}`, `{{config.<k>}}`, `{{viewer.<k>}}` or `<n>%`"
              }
             ]
            },
            "y": {
             "oneOf": [
              {
               "type": "number",
               "minimum": 0,
               "maximum": 4000
              },
              {
               "type": "string",
               "maxLength": 128,
               "description": "`{{item.<k>}}`, `{{config.<k>}}`, `{{viewer.<k>}}` or `<n>%`"
              }
             ]
            },
            "w": {
             "oneOf": [
              {
               "type": "number",
               "minimum": 0,
               "maximum": 4000
              },
              {
               "type": "string",
               "maxLength": 128,
               "description": "`{{item.<k>}}`, `{{config.<k>}}`, `{{viewer.<k>}}` or `<n>%`"
              }
             ]
            },
            "h": {
             "oneOf": [
              {
               "type": "number",
               "minimum": 0,
               "maximum": 4000
              },
              {
               "type": "string",
               "maxLength": 128,
               "description": "`{{item.<k>}}`, `{{config.<k>}}`, `{{viewer.<k>}}` or `<n>%`"
              }
             ]
            },
            "r": {
             "oneOf": [
              {
               "type": "number",
               "minimum": 0,
               "maximum": 4000
              },
              {
               "type": "string",
               "maxLength": 128,
               "description": "`{{item.<k>}}`, `{{config.<k>}}`, `{{viewer.<k>}}` or `<n>%`"
              }
             ]
            },
            "b": {
             "oneOf": [
              {
               "type": "number",
               "minimum": 0,
               "maximum": 4000
              },
              {
               "type": "string",
               "maxLength": 128,
               "description": "`{{item.<k>}}`, `{{config.<k>}}`, `{{viewer.<k>}}` or `<n>%`"
              }
             ]
            }
           }
          },
          "config": {
           "type": "object",
           "description": "the Block's config; strings may hold {{item.<k>}}, {{config.<k>}}, {{viewer.<k>}}"
          },
          "when": {
           "type": "string",
           "maxLength": 128,
           "description": "shown when this placeholder is truthy (`!` negates)"
          },
          "role": {
           "type": "string",
           "pattern": "^[a-z][a-z0-9_]{0,31}$"
          },
          "edit": {
           "type": "string",
           "maxLength": 64
          }
         }
        }
       }
      }
     },
     "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "algorithm",
       "item"
      ],
      "properties": {
       "algorithm": {
        "enum": [
         "list",
         "grid"
        ]
       },
       "columns": {
        "oneOf": [
         {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
         },
         {
          "$ref": "#/$defs/config_ref"
         }
        ]
       },
       "gap": {
        "oneOf": [
         {
          "type": "number",
          "minimum": 0,
          "maximum": 2000
         },
         {
          "$ref": "#/$defs/config_ref"
         }
        ]
       },
       "item": {
        "type": "object",
        "additionalProperties": false,
        "required": [
         "h"
        ],
        "properties": {
         "w": {
          "oneOf": [
           {
            "type": "number",
            "minimum": 0,
            "maximum": 4000
           },
           {
            "type": "string",
            "maxLength": 128,
            "description": "`{{item.<k>}}`, `{{config.<k>}}`, `{{viewer.<k>}}` or `<n>%`"
           }
          ]
         },
         "h": {
          "oneOf": [
           {
            "type": "number",
            "minimum": 0,
            "maximum": 4000
           },
           {
            "type": "string",
            "maxLength": 128,
            "description": "`{{item.<k>}}`, `{{config.<k>}}`, `{{viewer.<k>}}` or `<n>%`"
           }
          ]
         }
        }
       }
      }
     },
     "placement": {
      "enum": [
       "top",
       "stack",
       "bottom"
      ],
      "default": "stack"
     },
     "max_items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
     }
    }
   },
   "description": "manifest_version 4: Blocks projected from data — a template of label, shape and asset nodes instantiated per item, laid out as a list or a grid in a region placed like a slot. Never stored; identities `<control>.<projection>~<node>~<item>`."
  },
  "media": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "slot",
    "anchor"
   ],
   "properties": {
    "slot": {
     "type": "string",
     "pattern": "^[a-z][a-z0-9_]{0,31}$"
    },
    "anchor": {
     "type": "string",
     "maxLength": 64,
     "description": "a config property holding { pos_ms, at_ms, playing }: at server time at_ms the media was at pos_ms"
    },
    "loop": {
     "type": "string",
     "maxLength": 64,
     "description": "a boolean config property"
    }
   },
   "description": "manifest_version 4: the media Block of the slot plays where the anchor says, for every viewer by the service's clock; a viewer's own pause and mute stay on their device"
  }
 },
 "$defs": {
  "config_ref": {
   "type": "string",
   "pattern": "^\\{\\{config\\.[A-Za-z0-9_]{1,64}\\}\\}$",
   "description": "`{{config.<key>}}`: the instance's config value (its definition's default when unset); the key must be in config_schema.properties"
  }
 }
}