{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "buckyos.ai-workspace/commit-request/1.2",
 "title": "Commit request (doc.commit / doc.prepare)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "protocol_version",
  "workspace_id",
  "epoch",
  "idempotency_key",
  "operations"
 ],
 "properties": {
  "protocol_version": {
   "enum": [
    "1.0",
    "1.1",
    "1.2"
   ],
   "description": "1.1 added Block-controls (\"auto\" placement, Cells holding Cells in a control, slot); 1.2 is the finding / reading / querying API (no change to Commit requests); 1.0 and 1.1 requests are still accepted"
  },
  "workspace_id": {
   "type": "string",
   "pattern": "^ws_[0-9]{2}(0[1-9]|1[0-2])[0-9a-z]{4}$"
  },
  "epoch": {
   "type": "string",
   "pattern": "^ep_[a-z2-7]{26}$"
  },
  "idempotency_key": {
   "type": "string",
   "pattern": "^[\\x21-\\x7e]{1,128}$"
  },
  "session_id": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
  },
  "origin": {
   "enum": [
    "human",
    "agent",
    "program",
    "import",
    "system"
   ],
   "default": "human",
   "description": "Ignored: the service derives the origin (D08) — human, agent, program, import, system, source (a Source refresh) or build (ext.build / ext.import)."
  },
  "run_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "undo_group": {
   "type": [
    "string",
    "null"
   ]
  },
  "message": {
   "type": [
    "string",
    "null"
   ]
  },
  "preconditions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "target",
     "expect"
    ],
    "properties": {
     "target": {
      "type": "object",
      "required": [
       "entity_id"
      ],
      "properties": {
       "entity_id": {
        "$ref": "#/$defs/id"
       },
       "selector": {
        "$ref": "#/$defs/selector"
       }
      }
     },
     "expect": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "rev"
        ],
        "properties": {
         "rev": {
          "type": "integer",
          "minimum": 0
         }
        },
        "additionalProperties": false
       },
       {
        "type": "object",
        "required": [
         "hash"
        ],
        "properties": {
         "hash": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      ]
     }
    }
   }
  },
  "operations": {
   "type": "array",
   "minItems": 1,
   "maxItems": 10000,
   "items": {
    "type": "object",
    "required": [
     "op"
    ],
    "properties": {
     "op": {
      "type": "string"
     }
    }
   }
  }
 },
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
  },
  "expect": {
   "description": "Expected rev of the overwritten version cell. 0 = never written.",
   "type": "object",
   "required": [
    "rev"
   ],
   "properties": {
    "rev": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "selector": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "enum": [
      "entity",
      "doc_key",
      "table_members",
      "table_field",
      "table_field_type",
      "table_field_values",
      "table_record",
      "table_cell",
      "tree_children",
      "tree_edge",
      "richtext_block",
      "folder_member",
      "entity_prop",
      "table_view",
      "table_query"
     ]
    },
    "key": {
     "type": "string",
     "description": "doc_key: the payload key; entity_prop: the object key (config, bindings, on)"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "field_id": {
     "$ref": "#/$defs/id"
    },
    "block_id": {
     "$ref": "#/$defs/id"
    },
    "name": {
     "type": "string",
     "description": "folder_member: the member name; entity_prop: the property name"
    },
    "cell_id": {
     "$ref": "#/$defs/id",
     "description": "table_view: the table view Block"
    },
    "filter": {
     "type": "object"
    },
    "sorts": {
     "type": "array"
    },
    "fields": {
     "type": "array",
     "items": {
      "type": "string"
     }
    }
   }
  },
  "reference": {
   "type": "object",
   "required": [
    "entity_id"
   ],
   "additionalProperties": false,
   "properties": {
    "workspace_id": {
     "type": "string",
     "description": "Only for cross-Workspace references; internal references omit it."
    },
    "entity_id": {
     "$ref": "#/$defs/id"
    },
    "version": {
     "oneOf": [
      {
       "type": "object",
       "properties": {
        "mode": {
         "const": "live_head"
        }
       },
       "required": [
        "mode"
       ],
       "additionalProperties": false
      },
      {
       "type": "object",
       "properties": {
        "mode": {
         "const": "fixed_revision"
        },
        "object_id": {
         "type": "string"
        },
        "source_revision": {
         "type": "string"
        },
        "seq": {
         "type": "integer"
        }
       },
       "required": [
        "mode"
       ]
      },
      {
       "type": "object",
       "properties": {
        "mode": {
         "const": "published_channel"
        },
        "channel": {
         "type": "string"
        }
       },
       "required": [
        "mode",
        "channel"
       ]
      }
     ]
    },
    "selector": {
     "$ref": "#/$defs/selector"
    }
   }
  },
  "query_reference": {
   "type": "object",
   "required": [
    "kind",
    "source_url"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "url_query"
    },
    "source_url": {
     "type": "string",
     "description": "Absolute URL without credentials."
    },
    "query": {
     "type": "object"
    },
    "version": {
     "type": "object"
    },
    "consistency": {
     "enum": [
      "snapshot",
      "best_effort"
     ]
    }
   }
  },
  "placement": {
   "description": "Free-layout placement of a Block or group (entity.create / tree.move / tree.place), relative to the parent; stacking order is order_key. A connector's placement is the bounding box of its two stored endpoint positions: w and h may be 0, rotation is not allowed, it is required (never null), and with two coordinate ends (start and end absent or null) it must not be a single point (w + h > 0; not re-judged for undo, which may restore a box written while the ends were bound). Each of x, y, w, h may instead be the string \"auto\" (Block-controls, 脑图方案 §5.1): the value is not stored but computed when shown by the control laying the Block out; writing a number pins that component, writing \"auto\" back resets it. x / y may be \"auto\" only on a Block or container laid out by a control (its nearest enclosing container, walking up through Blocks, is a control such as mindmap, or a composite whose definition does not use the fixed layout); w / h only on a control (its box wraps its children) or on a text view (mindnode, shape, richtext; controls/core.json) laid out by one. A connector never has \"auto\".",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "x",
    "y",
    "w",
    "h"
   ],
   "properties": {
    "x": {
     "oneOf": [
      {
       "type": "number"
      },
      {
       "const": "auto"
      }
     ]
    },
    "y": {
     "oneOf": [
      {
       "type": "number"
      },
      {
       "const": "auto"
      }
     ]
    },
    "w": {
     "oneOf": [
      {
       "type": "number",
       "exclusiveMinimum": 0
      },
      {
       "const": "auto"
      }
     ],
     "description": "> 0 (>= 0 for a connector), or \"auto\""
    },
    "h": {
     "oneOf": [
      {
       "type": "number",
       "exclusiveMinimum": 0
      },
      {
       "const": "auto"
      }
     ],
     "description": "> 0 (>= 0 for a connector), or \"auto\""
    },
    "rotation": {
     "type": "number",
     "minimum": 0,
     "exclusiveMaximum": 360,
     "description": "degrees clockwise about the centre; not on a connector"
    }
   }
  },
  "connector_endpoint": {
   "description": "A bound endpoint of a connector. null (or an absent key) is a coordinate endpoint: the corresponding corner of the placement box (start = top-left, end = bottom-right, mirrored by flip). The target is a live, readable Cell (not a connector) or group on the same free-layout Surface; checked when written, not on import. Indexed as a `connector_endpoint` reference (src_selector {kind: connector_end, end: start|end}) that never blocks deleting the target. The anchor names one of the target's anchors; which ids exist is the target renderer's business (by default the 16-point compass n, nne, ne, … nnw of its outline), not checked here.",
   "type": [
    "object",
    "null"
   ],
   "additionalProperties": false,
   "required": [
    "entity_id",
    "anchor"
   ],
   "properties": {
    "entity_id": {
     "$ref": "#/$defs/id"
    },
    "anchor": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "kind",
      "id"
     ],
     "properties": {
      "kind": {
       "const": "named"
      },
      "id": {
       "type": "string",
       "pattern": "^[A-Za-z0-9_.:-]{1,64}$"
      }
     }
    }
   }
  },
  "connector_payload": {
   "description": "Payload of a buckyos.cell with view.type = connector (a line). The connector keys (flip, start, end, route, controls, label) are refused on any other view; a connector refuses source_ref, bindings, def_ref and the table-only keys, and its view.type can never change (nor can another Cell become a connector). config is appearance, checked by the front-end registry (<= 64 KiB). Self loop (start and end bound to the same entity): two different anchors and a route other than straight. Creating one needs a free-layout Surface.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "view"
   ],
   "properties": {
    "view": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "type"
     ],
     "properties": {
      "type": {
       "const": "connector"
      },
      "version": {
       "type": "integer",
       "minimum": 1,
       "description": "1 = connector@1 (its routing and interpolation); the core checks the format only"
      }
     }
    },
    "title": {
     "type": "string",
     "maxLength": 256,
     "description": "label text"
    },
    "config": {
     "type": "object"
    },
    "locked": {
     "type": "boolean"
    },
    "flip": {
     "type": [
      "object",
      "null"
     ],
     "additionalProperties": false,
     "properties": {
      "h": {
       "type": "boolean"
      },
      "v": {
       "type": "boolean"
      }
     }
    },
    "start": {
     "$ref": "#/$defs/connector_endpoint"
    },
    "end": {
     "$ref": "#/$defs/connector_endpoint"
    },
    "route": {
     "enum": [
      "straight",
      "elbow",
      "curve"
     ],
     "default": "straight"
    },
    "controls": {
     "type": "array",
     "maxItems": 64,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "u",
       "v"
      ],
      "properties": {
       "u": {
        "type": "number"
       },
       "v": {
        "type": "number"
       },
       "dx": {
        "type": "number"
       },
       "dy": {
        "type": "number"
       }
      }
     }
    },
    "label": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "t"
     ],
     "properties": {
      "t": {
       "type": "number",
       "minimum": 0,
       "maximum": 1
      },
      "offset": {
       "type": "number"
      }
     }
    }
   }
  },
  "formula_value": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "$formula"
   ],
   "properties": {
    "$formula": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "lang",
      "version",
      "expr"
     ],
     "properties": {
      "lang": {
       "const": "aiws"
      },
      "version": {
       "type": "string",
       "maxLength": 16
      },
      "expr": {
       "type": "string",
       "maxLength": 4096
      }
     }
    }
   },
   "description": "A formula in place of a value of the field's type (内核架构改进 D18): saved as given, evaluated by readers (the Desktop) and never by the backend; results to be read by others are materialized by an ordinary Commit with a derived record. Sorting, filtering and `unique` treat it as empty."
  },
  "set_props": {
   "description": "entity.set_props (扩展控件 P2, Q28): per-property writes of one object key. Each property is the version cell p:<key>.<name> (selector entity_prop); null removes it.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "op",
    "entity_id",
    "key",
    "props"
   ],
   "properties": {
    "op": {
     "const": "entity.set_props"
    },
    "entity_id": {
     "$ref": "#/$defs/id"
    },
    "key": {
     "enum": [
      "config",
      "bindings",
      "on"
     ]
    },
    "props": {
     "type": "object",
     "minProperties": 1,
     "maxProperties": 64,
     "propertyNames": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
     },
     "description": "<name>: value (≤ 64 KiB canonical) | null"
    },
    "expect": {
     "type": "object",
     "propertyNames": {
      "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"
     },
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     },
     "description": "<name>: the rev of p:<key>.<name> this write is based on (0 = never written); absent names merge"
    }
   }
  },
  "table_insert_records": {
   "description": "Insert records (auto-merge; append is enough without update). Built by the websdk's tableInsert.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "op",
    "source_id",
    "records"
   ],
   "properties": {
    "op": {
     "const": "table.insert_records"
    },
    "source_id": {
     "$ref": "#/$defs/id"
    },
    "records": {
     "type": "array",
     "minItems": 1,
     "maxItems": 10000,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "record_id"
      ],
      "properties": {
       "record_id": {
        "$ref": "#/$defs/id"
       },
       "values": {
        "type": "object",
        "description": "field_id → value of the field's type (README “Field types”: a select's option_id, a decimal string, `{ amount, currency }`, a reference object, `{ \"$formula\": … }`). Not the display form: the websdk's `tableInsert` / `tableSet` and `buckyos aiws table` turn field names and option labels into ids."
       },
       "body_ref": {
        "description": "The record's body: a rich text entity of the same table's content (reference object or entity id); null for none."
       },
       "meta": {
        "type": "object",
        "description": "Import and undo only (internal callers)."
       }
      }
     }
    },
    "field_type_revs": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     },
     "description": "field_id → the type_rev the values were written for; a changed type is a SCHEMA_CONFLICT. Optional."
    },
    "derived": {
     "type": "object",
     "description": "Provenance of values written by a program (`origin` program / agent with a run) or a materialized formula (`{ program: \"formula\", formula }`); stored per cell as `meta.derived`."
    }
   }
  },
  "table_set_values": {
   "description": "Set cells (overwrite: each item needs the cell's rev as read). Built by the websdk's tableSet.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "op",
    "source_id",
    "values"
   ],
   "properties": {
    "op": {
     "const": "table.set_values"
    },
    "source_id": {
     "$ref": "#/$defs/id"
    },
    "values": {
     "type": "array",
     "minItems": 1,
     "maxItems": 10000,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "record_id",
       "field_id",
       "value",
       "expect"
      ],
      "properties": {
       "record_id": {
        "$ref": "#/$defs/id"
       },
       "field_id": {
        "$ref": "#/$defs/id"
       },
       "value": {
        "description": "A value of the field's type (see table_insert_records.values)."
       },
       "expect": {
        "$ref": "#/$defs/expect"
       },
       "restore_meta": {
        "description": "Undo only (internal callers)."
       }
      }
     }
    },
    "field_type_revs": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     },
     "description": "field_id → the type_rev the values were written for; a changed type is a SCHEMA_CONFLICT. Optional."
    },
    "derived": {
     "type": "object",
     "description": "Provenance of values written by a program (`origin` program / agent with a run) or a materialized formula (`{ program: \"formula\", formula }`); stored per cell as `meta.derived`."
    }
   }
  },
  "table_unset_values": {
   "description": "Clear cells (overwrite). Built by the websdk's tableSet for null values.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "op",
    "source_id",
    "values"
   ],
   "properties": {
    "op": {
     "const": "table.unset_values"
    },
    "source_id": {
     "$ref": "#/$defs/id"
    },
    "values": {
     "type": "array",
     "minItems": 1,
     "maxItems": 10000,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "record_id",
       "field_id",
       "expect"
      ],
      "properties": {
       "record_id": {
        "$ref": "#/$defs/id"
       },
       "field_id": {
        "$ref": "#/$defs/id"
       },
       "expect": {
        "$ref": "#/$defs/expect"
       }
      }
     }
    },
    "field_type_revs": {
     "type": "object",
     "additionalProperties": {
      "type": "integer",
      "minimum": 0
     },
     "description": "field_id → the type_rev the values were written for; a changed type is a SCHEMA_CONFLICT. Optional."
    },
    "derived": {
     "type": "object",
     "description": "Provenance of values written by a program (`origin` program / agent with a run) or a materialized formula (`{ program: \"formula\", formula }`); stored per cell as `meta.derived`."
    }
   }
  },
  "table_delete_records": {
   "description": "Delete records (structural: each needs the record's rev as read). Built by the websdk's tableDelete.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "op",
    "source_id",
    "records"
   ],
   "properties": {
    "op": {
     "const": "table.delete_records"
    },
    "source_id": {
     "$ref": "#/$defs/id"
    },
    "records": {
     "type": "array",
     "minItems": 1,
     "items": {
      "type": "object",
      "additionalProperties": false,
      "required": [
       "record_id",
       "expect"
      ],
      "properties": {
       "record_id": {
        "$ref": "#/$defs/id"
       },
       "expect": {
        "$ref": "#/$defs/expect"
       }
      }
     }
    },
    "owned_bodies": {
     "enum": [
      "delete",
      "detach"
     ],
     "description": "What happens to the records' bodies; default delete."
    }
   }
  },
  "table_add_field": {
   "description": "Add a field (structure). Built by the websdk's fieldAdd.",
   "type": "object",
   "additionalProperties": false,
   "required": [
    "op",
    "source_id",
    "field"
   ],
   "properties": {
    "op": {
     "const": "table.add_field"
    },
    "source_id": {
     "$ref": "#/$defs/id"
    },
    "field": {
     "type": "object",
     "additionalProperties": false,
     "required": [
      "field_id",
      "name",
      "type"
     ],
     "description": "The field definition (README “Field types” for each type's keys).",
     "properties": {
      "field_id": {
       "$ref": "#/$defs/id"
      },
      "name": {
       "type": "string",
       "minLength": 1
      },
      "type": {
       "enum": [
        "text",
        "boolean",
        "number",
        "decimal",
        "date",
        "datetime",
        "select",
        "multi_select",
        "object_ref",
        "currency",
        "json"
       ]
      },
      "required": {
       "type": "boolean"
      },
      "nullable": {
       "type": "boolean"
      },
      "unique": {
       "type": "boolean"
      },
      "description": {
       "type": "string"
      },
      "maintained_by": {
       "enum": [
        "human",
        "program"
       ]
      },
      "scale": {
       "type": "integer",
       "minimum": 0,
       "maximum": 18
      },
      "options": {
       "type": "array",
       "items": {
        "$ref": "#/$defs/option"
       }
      },
      "target_types": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "currency": {
       "type": "string",
       "pattern": "^[A-Z]{3}$"
      },
      "submitter": {
       "type": "boolean"
      },
      "max_items": {
       "type": "integer",
       "minimum": 1,
       "maximum": 1000
      }
     }
    },
    "order_key": {
     "type": "string",
     "description": "Position among the fields; default after the last."
    },
    "backfill": {
     "description": "A value for the existing records (needed for a required field of a non-empty table)."
    }
   }
  },
  "option": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "option_id",
    "label"
   ],
   "properties": {
    "option_id": {
     "$ref": "#/$defs/id"
    },
    "label": {
     "type": "string",
     "minLength": 1
    }
   }
  },
