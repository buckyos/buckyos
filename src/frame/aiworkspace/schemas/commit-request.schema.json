{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "buckyos.ai-workspace/commit-request/0.2",
 "title": "Commit request (doc.commit / doc.prepare)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "protocol_version",
  "workspace_id",
  "epoch",
  "idempotency_key",
  "operations"
 ],
 "properties": {
  "protocol_version": {
   "const": "0.2"
  },
  "workspace_id": {
   "type": "string",
   "pattern": "^ws_[a-z2-7]{26}$"
  },
  "epoch": {
   "type": "string",
   "pattern": "^ep_[a-z2-7]{26}$"
  },
  "idempotency_key": {
   "type": "string",
   "pattern": "^[\\x21-\\x7e]{1,128}$"
  },
  "session_id": {
   "type": [
    "string",
    "null"
   ],
   "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
  },
  "origin": {
   "enum": [
    "human",
    "agent",
    "program",
    "import",
    "system"
   ],
   "default": "human"
  },
  "run_id": {
   "type": [
    "string",
    "null"
   ]
  },
  "undo_group": {
   "type": [
    "string",
    "null"
   ]
  },
  "message": {
   "type": [
    "string",
    "null"
   ]
  },
  "preconditions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "target",
     "expect"
    ],
    "properties": {
     "target": {
      "type": "object",
      "required": [
       "entity_id"
      ],
      "properties": {
       "entity_id": {
        "$ref": "#/$defs/id"
       },
       "selector": {
        "$ref": "#/$defs/selector"
       }
      }
     },
     "expect": {
      "oneOf": [
       {
        "type": "object",
        "required": [
         "rev"
        ],
        "properties": {
         "rev": {
          "type": "integer",
          "minimum": 0
         }
        },
        "additionalProperties": false
       },
       {
        "type": "object",
        "required": [
         "hash"
        ],
        "properties": {
         "hash": {
          "type": "string"
         }
        },
        "additionalProperties": false
       }
      ]
     }
    }
   }
  },
  "operations": {
   "type": "array",
   "minItems": 1,
   "maxItems": 10000,
   "items": {
    "type": "object",
    "required": [
     "op"
    ],
    "properties": {
     "op": {
      "type": "string"
     }
    }
   }
  }
 },
 "$defs": {
  "id": {
   "type": "string",
   "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
  },
  "expect": {
   "description": "Expected rev of the overwritten version cell. 0 = never written.",
   "type": "object",
   "required": [
    "rev"
   ],
   "properties": {
    "rev": {
     "type": "integer",
     "minimum": 0
    }
   },
   "additionalProperties": false
  },
  "selector": {
   "type": "object",
   "required": [
    "kind"
   ],
   "properties": {
    "kind": {
     "enum": [
      "entity",
      "doc_key",
      "table_field",
      "table_record",
      "table_cell",
      "richtext_block",
      "table_field_values",
      "table_members",
      "table_field_type"
     ]
    },
    "key": {
     "type": "string"
    },
    "record_id": {
     "$ref": "#/$defs/id"
    },
    "field_id": {
     "$ref": "#/$defs/id"
    },
    "block_id": {
     "$ref": "#/$defs/id"
    }
   }
  },
  "reference": {
   "type": "object",
   "required": [
    "entity_id"
   ],
   "additionalProperties": false,
   "properties": {
    "workspace_id": {
     "type": "string",
     "description": "Only for cross-Workspace references; internal references omit it."
    },
    "entity_id": {
     "$ref": "#/$defs/id"
    },
    "version": {
     "oneOf": [
      {
       "type": "object",
       "properties": {
        "mode": {
         "const": "live_head"
        }
       },
       "required": [
        "mode"
       ],
       "additionalProperties": false
      },
      {
       "type": "object",
       "properties": {
        "mode": {
         "const": "fixed_revision"
        },
        "object_id": {
         "type": "string"
        },
        "source_revision": {
         "type": "string"
        },
        "seq": {
         "type": "integer"
        }
       },
       "required": [
        "mode"
       ]
      },
      {
       "type": "object",
       "properties": {
        "mode": {
         "const": "published_channel"
        },
        "channel": {
         "type": "string"
        }
       },
       "required": [
        "mode",
        "channel"
       ]
      }
     ]
    },
    "selector": {
     "$ref": "#/$defs/selector"
    }
   }
  },
  "query_reference": {
   "type": "object",
   "required": [
    "kind",
    "source_url"
   ],
   "additionalProperties": false,
   "properties": {
    "kind": {
     "const": "url_query"
    },
    "source_url": {
     "type": "string",
     "description": "Absolute URL without credentials."
    },
    "query": {
     "type": "object"
    },
    "version": {
     "type": "object"
    },
    "consistency": {
     "enum": [
      "snapshot",
      "best_effort"
     ]
    }
   }
  }
 }
}